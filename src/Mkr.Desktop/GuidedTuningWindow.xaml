<Window x:Class="Mkr.Desktop.GuidedTuningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MKR — Réglage guidé" Width="900" Height="720" MinWidth="640" MinHeight="520" WindowStartupLocation="CenterOwner">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource MkrAccentPale}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap"
                       Text="Vous choisissez un objectif de robustesse, pas un temps de réponse. MKR cherche le réglage le plus rapide qui reste robuste sur le modèle identifié et sur l'incertitude de ses paramètres (règles SIMC, Skogestad 2003 ; sensibilité maximale Ms, Åström et Hägglund 2006). Si les données ne permettent pas d'en garantir un, MKR refuse et dit quoi faire. Résultat théorique, jamais qualifié sur installation."/>
        </Border>
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="ModelLine" TextWrapping="Wrap" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,8,0,0">
                <Label Content="_Objectif" Target="{Binding ElementName=Objective}" VerticalAlignment="Center"/>
                <ComboBox x:Name="Objective" Width="330" SelectedIndex="1" SelectionChanged="ObjectiveChanged" AutomationProperties.Name="Objectif de robustesse">
                    <ComboBoxItem Tag="robust" Content="Robuste · Ms ≤ 1,4 (marge élevée)"/>
                    <ComboBoxItem Tag="balanced" Content="Équilibré · Ms ≤ 1,7"/>
                    <ComboBoxItem Tag="performance" Content="Performance · Ms ≤ 2,0 (plus rapide)"/>
                </ComboBox>
                <Button x:Name="Compute" Content="_Calculer le réglage guidé" Click="Calculate" Margin="10,0,0,0" Style="{StaticResource MkrPrimaryButton}"/>
            </WrapPanel>
            <TextBlock x:Name="ObjectiveHelp" TextWrapping="Wrap" Foreground="{DynamicResource MkrMuted}" Margin="0,6,0,0"/>
            <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel>
                <Border x:Name="Verdict" Visibility="Collapsed" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                    <TextBlock x:Name="VerdictText" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource MkrOnStatus}"/>
                </Border>
                <TextBox x:Name="Result" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas" Visibility="Collapsed"
                         AutomationProperties.Name="Résultat du réglage guidé"/>
                <TextBlock x:Name="AlternativesTitle" Text="Réglages voisins (vitesse contre robustesse)" FontWeight="SemiBold" Margin="0,12,0,6" Visibility="Collapsed"/>
                <DataGrid x:Name="Alternatives" Visibility="Collapsed" RowHeight="28" ColumnHeaderHeight="28" AutomationProperties.Name="Réglages voisins">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Réponse τc (s)" Binding="{Binding Response}" Width="*"/>
                        <DataGridTextColumn Header="Kp" Binding="{Binding Kp}" Width="*"/>
                        <DataGridTextColumn Header="Ti (s)" Binding="{Binding Ti}" Width="*"/>
                        <DataGridTextColumn Header="Td (s)" Binding="{Binding Td}" Width="*"/>
                        <DataGridTextColumn Header="Ms au pire cas" Binding="{Binding Ms}" Width="*"/>
                        <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button x:Name="CopyButton" Content="Co_pier le résultat" IsEnabled="False" Click="Copy" Margin="0,0,8,0"/>
            <Button Content="_Fermer" IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>
