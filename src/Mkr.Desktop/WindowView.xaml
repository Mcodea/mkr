<Window x:Class="Mkr.Desktop.WindowView" Title="MKR — Espace projets" KeyDown="WindowKeyDown"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1120" Height="740" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="MkrNavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MkrNavyText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource MkrNavySoft}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource MkrNavyText}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MkrNavyMuted}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Barre supérieure : identité, projet actif, aide, thème, état -->
        <Border Grid.Row="0" Background="{DynamicResource MkrNavy}" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="NavToggle" Style="{StaticResource MkrNavButton}" Click="ToggleNavigation" Padding="9,7" Margin="0,0,10,0"
                        AutomationProperties.Name="Réduire ou développer le menu" ToolTip="Réduire ou développer le menu">
                    <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MKR" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource MkrNavyText}"/>
                    <TextBlock Text="Ingénierie de régulation" FontSize="11" Foreground="{DynamicResource MkrNavyMuted}" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource MkrNavySoft}" CornerRadius="6" Padding="12,5" Margin="24,0,12,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="ActiveProject" Text="Aucun projet sélectionné" Foreground="{DynamicResource MkrNavyText}" TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="Projet actif" AutomationProperties.LiveSetting="Polite"/>
                </Border>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource MkrNavySoft}" CornerRadius="6" Padding="10,5" Margin="0,0,10,0"
                            ToolTip="MKR lit les données de l’automate et n’y écrit jamais." AutomationProperties.Name="Automate : lecture seule">
                        <TextBlock Text="Automate : lecture seule" Foreground="{DynamicResource MkrNavyText}" FontSize="12"/>
                    </Border>
                    <ComboBox x:Name="ThemeChoice" SelectionChanged="ThemeChanged" Width="150" Margin="0,0,10,0" AutomationProperties.Name="Thème de l'interface">
                        <ComboBoxItem Content="Suivre Windows" Tag="System"/>
                        <ComboBoxItem Content="Clair" Tag="Light"/>
                        <ComboBoxItem Content="Sombre" Tag="Dark"/>
                    </ComboBox>
                    <Button Style="{StaticResource MkrNavButton}" Click="OpenHelp" Padding="12,7" AutomationProperties.Name="Aide" ToolTip="Aide et vocabulaire (F1)">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="16"/><TextBlock Text="Aide" Margin="8,0,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Navigation latérale repliable : uniquement des fonctions réelles -->
            <Border Grid.Column="0" Background="{DynamicResource MkrNavy}">
                <StackPanel Margin="8,14,8,10">
                    <TextBlock x:Name="SpaceHeading" Text="ESPACE DE TRAVAIL" Foreground="{DynamicResource MkrNavyMuted}" FontSize="10" FontWeight="SemiBold" Margin="12,0,0,8"/>
                    <Button x:Name="NavHome" Style="{StaticResource MkrNavButton}" Click="ShowHome" AutomationProperties.Name="Accueil" ToolTip="Accueil">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" VerticalAlignment="Center"/><TextBlock x:Name="NavHomeLabel" Text="Accueil" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavCatalogue" Style="{StaticResource MkrNavButton}" Click="OpenCatalogue" AutomationProperties.Name="Ouvrir le catalogue des blocs" ToolTip="Ouvrir le catalogue des blocs">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" VerticalAlignment="Center"/><TextBlock x:Name="NavCatalogueLabel" Text="Catalogue des blocs" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <TextBlock x:Name="StudyHeading" Text="ÉTUDE DU PROJET ACTIF" Foreground="{DynamicResource MkrNavyMuted}" FontSize="10" FontWeight="SemiBold" Margin="12,22,0,8"/>
                    <Button x:Name="NavData" Style="{StaticResource MkrNavButton}" Click="OpenProject" AutomationProperties.Name="Ouvrir les données et l’acquisition du projet actif" ToolTip="Ouvrir les données et l’acquisition du projet actif" IsEnabled="False">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" VerticalAlignment="Center"/><TextBlock x:Name="NavDataLabel" Text="Données et acquisition" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavIdentification" Style="{StaticResource MkrNavButton}" Click="OpenIdentification" AutomationProperties.Name="Ouvrir l’identification et le réglage du projet actif" ToolTip="Ouvrir l’identification et le réglage du projet actif" IsEnabled="False">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" VerticalAlignment="Center"/><TextBlock x:Name="NavIdentificationLabel" Text="Identification et réglage" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <!-- Espace central -->
            <Grid Grid.Column="1" Margin="28,22,28,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="ACCUEIL" Foreground="{DynamicResource MkrAccent}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Mes projets" FontWeight="SemiBold" FontSize="26"/>
                    <TextBlock Text="Créez ou sélectionnez un projet, puis suivez le parcours d'étude." Foreground="{DynamicResource MkrMuted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Background="{DynamicResource MkrAccentPale}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Parcours d'étude" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="1. Décrire la boucle, importer ou acquérir des données  →  2. Identifier le procédé et valider le modèle  →  3. Régler, simuler, préparer les valeurs du bloc (toujours à qualifier sur banc)."/>
                    </StackPanel>
                </Border>
            <Border Grid.Row="2" Background="{DynamicResource MkrSurface}"
                    BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" CornerRadius="8"
                    Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Nouveau projet" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Text="Donnez un nom explicite à votre étude."
                               Foreground="{DynamicResource MkrMuted}" Margin="0,5,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Content="_Nom du projet" Target="{Binding ElementName=ProjectName}"
                                   Padding="0" Margin="0,0,0,4" FontWeight="SemiBold"/>
                            <TextBox x:Name="ProjectName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="120" AutomationProperties.Name="Nom du nouveau projet"
                                     ToolTip="Nom du projet (120 caractères maximum)"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource MkrPrimaryButton}"
                                Content="_Créer le projet" Command="{Binding CreateProject}"
                                VerticalAlignment="Bottom" Margin="12,0,0,0"
                                AutomationProperties.Name="Créer le projet"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Row="3" Background="{DynamicResource MkrSurface}"
                    BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" CornerRadius="8"
                    Padding="16" MinHeight="120">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Projets enregistrés" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Sélectionnez une ligne, puis ouvrez le projet."
                                   Foreground="{DynamicResource MkrMuted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="ProjectList" Grid.Row="1" SelectionChanged="ProjectSelected" MouseDoubleClick="OpenProject"
                              ItemsSource="{Binding Projects}"
                              AlternationCount="2"
                              AlternatingRowBackground="{DynamicResource MkrCanvas}"
                              AutomationProperties.Name="Projets enregistrés"
                              SelectionMode="Single" IsReadOnly="True" CanUserAddRows="False"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Projet" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Création (UTC)"
                                                Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                                Width="165"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Les projets sont enregistrés localement."
                                   Foreground="{DynamicResource MkrMuted}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Style="{StaticResource MkrPrimaryButton}"
                                Content="_Ouvrir le projet sélectionné" Click="OpenProject"
                                AutomationProperties.Name="Ouvrir le projet sélectionné"/>
                    </Grid>
                </Grid>
            </Border>
            </Grid>
        </Grid>
        <!-- Barre d'état -->
        <Border Grid.Row="2" Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MkrMuted}" Margin="0,0,12,0"
                           AutomationProperties.LiveSetting="Polite"/>
                <Button Grid.Column="1" Content="_Vérifier le moteur Python" Command="{Binding CheckEngine}" Margin="0,0,12,0"
                        ToolTip="Vérifier la disponibilité du moteur scientifique local"/>
                <TextBlock Grid.Column="2" x:Name="VersionText" Foreground="{DynamicResource MkrMuted}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>