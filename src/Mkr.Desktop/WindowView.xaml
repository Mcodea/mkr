<Window x:Class="Mkr.Desktop.WindowView" Title="{local:Loc ui.orias_espace_projets}" KeyDown="WindowKeyDown"
        AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource Self}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mkr.Desktop"
        Width="1180" Height="760" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" WindowStyle="None" ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="MkrBarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MkrNavyText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource MkrNavySoft}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource MkrNavyText}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MkrNavyMuted}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MkrNavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MkrText}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource MkrAccentPale}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource MkrNavy}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MkrNavyText}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource MkrAccent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MkrRibbonTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MkrMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource MkrAccentPale}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource MkrAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MkrText}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource MkrText}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MkrRibbonButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MkrText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="92"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource MkrAccentPale}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource MkrAccent}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MkrMuted}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootFrame">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border x:Name="CaptionBar" Grid.Row="0" Height="30" Background="{DynamicResource MkrTitleBar}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource MkrCaptionButton}" Click="CaptionMinimize" ToolTip="{local:Loc ui.reduire_la_fenetre}" AutomationProperties.Name="{local:Loc ui.minimiser_la_fenetre}" WindowChrome.IsHitTestVisibleInChrome="True" ><TextBlock x:Name="MinimizeGlyph" Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/></Button>
                <Button Style="{StaticResource MkrCaptionButton}" Click="CaptionMaximize" ToolTip="{local:Loc ui.agrandir_ou_restaurer}" AutomationProperties.Name="{local:Loc ui.maximiser_ou_restaurer_la_fenetre}" WindowChrome.IsHitTestVisibleInChrome="True"><TextBlock x:Name="MaximizeGlyph" Text="&#xE923;" FontFamily="Segoe MDL2 Assets" FontSize="10"/></Button>
                <Button Style="{StaticResource MkrCaptionButton}" Click="CaptionClose" ToolTip="{local:Loc ui.fermer_la_fenetre}" AutomationProperties.Name="{local:Loc ui.fermer_la_fenetre}" WindowChrome.IsHitTestVisibleInChrome="True" Tag="close"><TextBlock x:Name="CloseGlyph" Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/></Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <Image Source="{DynamicResource OriasSymbol}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource MkrText}" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>
    </Border>
    <Grid Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Barre de menus -->
        <Menu Grid.Row="0" Background="{DynamicResource MkrSurface}" Foreground="{DynamicResource MkrText}" Padding="4,2" AutomationProperties.Name="{local:Loc ui.menus}">
            <MenuItem Header="{local:Loc ui.fichier}">
                <MenuItem Header="{local:Loc ui.nouveau_projet}" Click="MenuNewProject"/>
                <MenuItem Header="{local:Loc ui.accueil_liste_des_projets}" Click="MenuHome"/>
                <Separator/>
                <MenuItem Header="{local:Loc ui.quitter}" Click="MenuQuit"/>
            </MenuItem>
            <MenuItem Header="{local:Loc ui.affichage}">
                <MenuItem x:Name="MenuAssisted" Header="{local:Loc ui.mode_assiste}" IsCheckable="True" IsChecked="True" Click="MenuMode"/>
                <MenuItem x:Name="MenuExpert" Header="{local:Loc ui.mode_expert}" IsCheckable="True" Click="MenuMode"/>
                <Separator/>
                <MenuItem x:Name="MenuThemeSystem" Header="{local:Loc ui.theme_suivre_windows}" IsCheckable="True" Click="MenuTheme" Tag="System"/>
                <MenuItem x:Name="MenuThemeLight" Header="{local:Loc ui.theme_clair}" IsCheckable="True" Click="MenuTheme" Tag="Light"/>
                <MenuItem x:Name="MenuThemeDark" Header="{local:Loc ui.theme_sombre}" IsCheckable="True" Click="MenuTheme" Tag="Dark"/>
                <Separator/>
                <MenuItem Header="{local:Loc ui.langue_francais}" Click="MenuLanguage" Tag="fr"/>
                <MenuItem Header="{local:Loc ui.language_english}" Click="MenuLanguage" Tag="en"/>
            </MenuItem>
            <MenuItem Header="{local:Loc ui.projet}">
                <MenuItem Header="{local:Loc ui.description_de_la_boucle}" Click="MenuDescription"/>
                <MenuItem Header="{local:Loc ui.journal_d_audit_2}" Click="MenuAudit"/>
                <MenuItem Header="{local:Loc ui.revue_de_l_etude_2}" Click="MenuReview"/>
            </MenuItem>
            <MenuItem Header="{local:Loc ui.outils}">
                <MenuItem Header="{local:Loc ui.catalogue_des_blocs_constructeurs}" Click="OpenCatalogue"/>
                <MenuItem Header="{local:Loc ui.verifier_le_moteur_python}" Command="{Binding CheckEngine}"/>
            </MenuItem>
            <MenuItem Header="{local:Loc ui.aide}">
                <MenuItem Header="{local:Loc ui.aide_et_vocabulaire_f1}" Click="OpenHelp"/>
                <MenuItem Header="{local:Loc ui.a_propos_dorias}" Click="OpenAbout"/>
            </MenuItem>
        </Menu>
        <!-- Barre d'outils : accès direct aux grandes étapes -->
        <Border x:Name="ToolbarBand" Grid.Row="1" Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="0,1,0,1" Padding="6,2">
            <StackPanel x:Name="Toolbar" Orientation="Horizontal"/>
        </Border>
        <!-- En-tête : produit, projet, étude -->
        <Border Grid.Row="2" Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="0,0,0,1" Padding="14,3">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{DynamicResource OriasLogo}" Height="34" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="ORIAS"/>
                    <Border Width="1" Background="{DynamicResource MkrBorder}" Margin="18,2,18,2"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock AutomationProperties.Name="{local:Loc ui.projet_actif}" AutomationProperties.LiveSetting="Polite"><Run Text="{local:Loc ui.projet_2}" FontWeight="SemiBold"/><Run x:Name="ActiveProject" Text="{local:Loc ui.aucun_projet_selectionne}"/></TextBlock>
                    <TextBlock x:Name="ActiveStudy" Foreground="{DynamicResource MkrMuted}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource MkrSurfaceAlt}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center"
                        ToolTip="{local:Loc ui.orias_lit_les_donnees_de}" AutomationProperties.Name="{local:Loc ui.automate_lecture_seule}">
                    <TextBlock Text="{local:Loc ui.automate_lecture_seule}" FontSize="12"/>
                </Border>
            </Grid>
        </Border>
        <!-- Accueil -->
        <Grid x:Name="HomeView" Grid.Row="3" Margin="28,20,28,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <Image Source="{DynamicResource OriasLogo}" Height="46" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="ORIAS"/>
                    <TextBlock x:Name="HomeTagline" Foreground="{DynamicResource MkrAccent}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,10"/>
                    <TextBlock Text="{local:Loc ui.mes_projets}" FontWeight="SemiBold" FontSize="26"/>
                    <TextBlock Text="{local:Loc ui.creez_ou_selectionnez_un_projet}" Foreground="{DynamicResource MkrMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HomeCatalogue" Content="{local:Loc ui.catalogue_des_blocs_2}" Click="OpenCatalogue" Margin="0,0,8,0" AutomationProperties.Name="{local:Loc ui.ouvrir_le_catalogue_des_blocs}"/>
                    <Button x:Name="OpenStudy" Style="{StaticResource MkrPrimaryButton}" Content="{local:Loc ui.ouvrir_l_espace_d_etude}" Click="EnterStudy" IsEnabled="False"
                            AutomationProperties.Name="{local:Loc ui.ouvrir_l_espace_d_etude_2}" ToolTip="{local:Loc ui.selectionnez_d_abord_un_projet}"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource MkrSurface}"
                    BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" CornerRadius="8"
                    Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{local:Loc ui.nouveau_projet_2}" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Text="{local:Loc ui.donnez_un_nom_explicite_a}"
                               Foreground="{DynamicResource MkrMuted}" Margin="0,5,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Content="{local:Loc ui.nom_du_projet}" Target="{Binding ElementName=ProjectName}"
                                   Padding="0" Margin="0,0,0,4" FontWeight="SemiBold"/>
                            <TextBox x:Name="ProjectName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="120" AutomationProperties.Name="{local:Loc ui.nom_du_nouveau_projet}"
                                     ToolTip="{local:Loc ui.nom_du_projet_120_caracteres}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource MkrPrimaryButton}"
                                Content="{local:Loc ui.creer_le_projet}" Command="{Binding CreateProject}"
                                VerticalAlignment="Bottom" Margin="12,0,0,0"
                                AutomationProperties.Name="{local:Loc ui.creer_le_projet_2}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Background="{DynamicResource MkrSurface}"
                    BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" CornerRadius="8"
                    Padding="16" MinHeight="120">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{local:Loc ui.projets_enregistres}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{local:Loc ui.selectionnez_une_ligne_puis_ouvrez}"
                                   Foreground="{DynamicResource MkrMuted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="ProjectList" Grid.Row="1" SelectionChanged="ProjectSelected" MouseDoubleClick="OpenProject"
                              ItemsSource="{Binding Projects}"
                              AlternationCount="2"
                              AlternatingRowBackground="{DynamicResource MkrCanvas}"
                              AutomationProperties.Name="{local:Loc ui.projets_enregistres}"
                              SelectionMode="Single" IsReadOnly="True" CanUserAddRows="False"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{local:Loc ui.projet_3}" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="{local:Loc ui.creation_utc}"
                                                Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                                Width="165"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{local:Loc ui.les_projets_sont_enregistres_localement}"
                                   Foreground="{DynamicResource MkrMuted}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Style="{StaticResource MkrPrimaryButton}"
                                Content="{local:Loc ui.ouvrir_le_projet_selectionne}" Click="OpenProject"
                                AutomationProperties.Name="{local:Loc ui.ouvrir_le_projet_selectionne_2}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!-- Espace d'étude : navigation à gauche, titre et étapes, barre d'écran, contenu -->
        <Grid x:Name="StudyView" Grid.Row="3" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TabStrip" Margin="6,10,6,10"/>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="TitleBar" Grid.Row="0" Margin="14,6,10,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="ScreenTitle" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" AutomationProperties.LiveSetting="Polite"/>
                    <Grid x:Name="Stages" Grid.Column="1" Height="34" HorizontalAlignment="Stretch"/>
                </Grid>
                <Border x:Name="RibbonHost" Grid.Row="1" Background="{DynamicResource MkrSurfaceAlt}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="0,1,0,1" Padding="10,4" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel x:Name="RibbonCommands" Orientation="Horizontal"/>
                        <TextBlock x:Name="RibbonNote" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="{DynamicResource MkrMuted}"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </Grid>
                </Border>
                <!-- Zone adaptative : le contenu garde une taille minimale lisible (graphiques entiers) ; en dessous, la page défile au lieu de couper -->
                <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" SizeChanged="PageScrollSized"
                              AutomationProperties.Name="{local:Loc ui.contenu_de_l_etape}">
                <Grid x:Name="PageBody" MinHeight="470" MinWidth="720">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="ValuesColumn" Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="10,8,10,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton x:Name="ShowTraining" Content="{local:Loc ui.essai_d_estimation}" GroupName="Trial" IsChecked="True" Checked="TrialChanged" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="ShowValidation" Content="{local:Loc ui.essai_de_validation}" GroupName="Trial" Checked="TrialChanged" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <local:SignalChart x:Name="Chart" Grid.Row="1" MinHeight="260" ReferenceStyle="True" ShowValueBoxes="False" AutomationProperties.Name="{local:Loc ui.mesure_observee_et_modele_sortie}"
                            AutomationProperties.HelpText="{local:Loc ui.molette_zoom_clic_droit_glisse}"/>
                        <TextBlock x:Name="CursorText" Grid.Row="2" Text="{local:Loc ui.survolez_le_graphique_pour_lire}" Foreground="{DynamicResource MkrMuted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <ScrollViewer x:Name="ValuesPanel" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,8,10,6">
                        <StackPanel>
                            <Expander Style="{StaticResource MkrPanel}" Header="{local:Loc ui.validation_du_modele}">
                                <StackPanel Margin="10,8">
                                    <Border x:Name="Verdict" CornerRadius="3" Padding="10,5" Margin="0,0,0,8" Background="{DynamicResource MkrBorderStrong}">
                                        <TextBlock x:Name="VerdictText" Text="{local:Loc ui.aucune_etude}" FontWeight="Bold" Foreground="{DynamicResource MkrOnStatus}"/>
                                    </Border>
                                    <Label Content="{local:Loc ui.etude_affichee}" Target="{Binding ElementName=StudyPicker}" Padding="0,0,0,2"/>
                                    <ComboBox x:Name="StudyPicker" DisplayMemberPath="Label" SelectionChanged="PickerChanged" AutomationProperties.Name="{local:Loc ui.etude_affichee_2}">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                    <TextBlock x:Name="ValuesNote" TextWrapping="Wrap" Foreground="{DynamicResource MkrMuted}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Expander>
                            <Expander Style="{StaticResource MkrPanel}" Header="{local:Loc ui.parametres_du_modele}">
                                <TextBlock x:Name="ValuesText" TextWrapping="Wrap" Margin="10,8" LineHeight="22"/>
                            </Expander>
                            <Expander Style="{StaticResource MkrPanel}" Header="{local:Loc ui.projet_3}">
                                <TextBlock x:Name="InspectorFacts" TextWrapping="Wrap" Margin="10,8" Foreground="{DynamicResource MkrMuted}"/>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Contenu de l'étape affiché dans la fenêtre (réglage guidé, simulation…) : recouvre le graphique quand l'étape a sa propre vue -->
                    <Border x:Name="StepHost" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource MkrCanvas}"/>
                </Grid>
                <Border x:Name="StudyTablePanel" Grid.Row="1" Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="0,1,0,0">
                    <Grid Margin="10,6,10,6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Button x:Name="TableToggle" Content="{local:Loc ui.tableau_des_etudes_d_identification}" Click="ToggleTable" HorizontalAlignment="Left" Margin="0,0,0,4" Padding="8,3"
                                AutomationProperties.Name="{local:Loc ui.afficher_ou_masquer_le_tableau}"/>
                        <DataGrid x:Name="StudyGrid" Grid.Row="1" Height="130" Visibility="Collapsed" RowHeight="26" ColumnHeaderHeight="26" SelectionChanged="StudySelected" AutomationProperties.Name="{local:Loc ui.etudes_d_identification_du_projet}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{local:Loc ui.famille}" Binding="{Binding Family}" Width="90"/>
                                <DataGridTextColumn Header="{local:Loc ui.gain_k}" Binding="{Binding Gain}" Width="*"/>
                                <DataGridTextColumn Header="{local:Loc ui.constante_s}" Binding="{Binding Tau}" Width="*"/>
                                <DataGridTextColumn Header="{local:Loc ui.retard_s}" Binding="{Binding Delay}" Width="*"/>
                                <DataGridTextColumn Header="{local:Loc ui.erreur_de_validation}" Binding="{Binding Error}" Width="*"/>
                                <DataGridTextColumn Header="{local:Loc ui.decision}" Binding="{Binding Decision}" Width="110"/>
                                <DataGridTextColumn Header="{local:Loc ui.calculee}" Binding="{Binding When}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
    
                </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
        <!-- Barre d'état : état, faits du projet, étape suivante -->
        <Border Grid.Row="4" Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MkrSuccess}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <TextBlock x:Name="StatusFacts" Grid.Column="1" Margin="22,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource MkrMuted}" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="NextButton" Grid.Column="2" Style="{StaticResource MkrPrimaryButton}" Click="GoToNext" Visibility="Collapsed" MinHeight="32" Padding="16,4"
                        AutomationProperties.Name="{local:Loc ui.aller_a_la_prochaine_etape}"/>
                <TextBlock Grid.Column="3" x:Name="VersionText" Foreground="{DynamicResource MkrMuted}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Window>