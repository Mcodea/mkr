<Window x:Class="Mkr.Desktop.WindowView" Title="MKR — Espace projets" KeyDown="WindowKeyDown"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mkr.Desktop"
        Width="1180" Height="760" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.Resources>
        <Style x:Key="MkrBarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MkrNavyText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource MkrNavySoft}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource MkrNavyText}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MkrNavyMuted}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MkrNavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MkrText}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource MkrAccentPale}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource MkrNavy}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MkrNavyText}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource MkrAccent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MkrRibbonTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MkrMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource MkrAccentPale}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource MkrAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MkrText}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource MkrText}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MkrRibbonButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MkrText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="92"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource MkrAccentPale}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource MkrAccent}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MkrMuted}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Barre de menus -->
        <Menu Grid.Row="0" Background="{DynamicResource MkrSurface}" Foreground="{DynamicResource MkrText}" Padding="4,2" AutomationProperties.Name="Menus">
            <MenuItem Header="_Fichier">
                <MenuItem Header="_Nouveau projet…" Click="MenuNewProject"/>
                <MenuItem Header="_Accueil (liste des projets)" Click="MenuHome"/>
                <Separator/>
                <MenuItem Header="_Quitter" Click="MenuQuit"/>
            </MenuItem>
            <MenuItem Header="_Affichage">
                <MenuItem x:Name="MenuAssisted" Header="Mode _assisté" IsCheckable="True" IsChecked="True" Click="MenuMode"/>
                <MenuItem x:Name="MenuExpert" Header="Mode _expert" IsCheckable="True" Click="MenuMode"/>
                <Separator/>
                <MenuItem x:Name="MenuThemeSystem" Header="Thème : suivre _Windows" IsCheckable="True" Click="MenuTheme" Tag="System"/>
                <MenuItem x:Name="MenuThemeLight" Header="Thème : _clair" IsCheckable="True" Click="MenuTheme" Tag="Light"/>
                <MenuItem x:Name="MenuThemeDark" Header="Thème : _sombre" IsCheckable="True" Click="MenuTheme" Tag="Dark"/>
            </MenuItem>
            <MenuItem Header="_Projet">
                <MenuItem Header="_Description de la boucle" Click="MenuDescription"/>
                <MenuItem Header="_Journal d'audit" Click="MenuAudit"/>
                <MenuItem Header="_Revue de l'étude" Click="MenuReview"/>
            </MenuItem>
            <MenuItem Header="_Outils">
                <MenuItem Header="_Catalogue des blocs constructeurs" Click="OpenCatalogue"/>
                <MenuItem Header="_Vérifier le moteur Python" Command="{Binding CheckEngine}"/>
            </MenuItem>
            <MenuItem Header="Ai_de">
                <MenuItem Header="Aide et _vocabulaire (F1)" Click="OpenHelp"/>
            </MenuItem>
        </Menu>
        <!-- Barre d'outils : accès direct aux grandes étapes -->
        <Border x:Name="ToolbarBand" Grid.Row="1" Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="0,1,0,1" Padding="6,2">
            <StackPanel x:Name="Toolbar" Orientation="Horizontal"/>
        </Border>
        <!-- En-tête : produit, projet, étude -->
        <Border Grid.Row="2" Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="0,0,0,1" Padding="14,3">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid VerticalAlignment="Center" AutomationProperties.Name="MKR, Make Régulation">
                        <Path Data="M0,22 C8,28 24,26 34,8" Stroke="{DynamicResource MkrAccent}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0"/>
                        <StackPanel Margin="44,0,0,0">
                            <TextBlock Text="MKR" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource MkrBrand}" LineHeight="26" LineStackingStrategy="BlockLineHeight"/>
                            <TextBlock Text="Make Régulation" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MkrBrand}" Margin="0,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Border Width="1" Background="{DynamicResource MkrBorder}" Margin="18,2,18,2"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock AutomationProperties.Name="Projet actif" AutomationProperties.LiveSetting="Polite"><Run Text="Projet : " FontWeight="SemiBold"/><Run x:Name="ActiveProject" Text="aucun projet sélectionné"/></TextBlock>
                    <TextBlock x:Name="ActiveStudy" Foreground="{DynamicResource MkrMuted}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource MkrSurfaceAlt}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center"
                        ToolTip="MKR lit les données de l’automate et n’y écrit jamais." AutomationProperties.Name="Automate : lecture seule">
                    <TextBlock Text="Automate : lecture seule" FontSize="12"/>
                </Border>
            </Grid>
        </Border>
        <!-- Accueil -->
        <Grid x:Name="HomeView" Grid.Row="3" Margin="28,20,28,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ACCUEIL" Foreground="{DynamicResource MkrAccent}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Mes projets" FontWeight="SemiBold" FontSize="26"/>
                    <TextBlock Text="Créez ou sélectionnez un projet, puis ouvrez son espace d'étude." Foreground="{DynamicResource MkrMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HomeCatalogue" Content="_Catalogue des blocs" Click="OpenCatalogue" Margin="0,0,8,0" AutomationProperties.Name="Ouvrir le catalogue des blocs"/>
                    <Button x:Name="OpenStudy" Style="{StaticResource MkrPrimaryButton}" Content="Ouvrir l'_espace d'étude" Click="EnterStudy" IsEnabled="False"
                            AutomationProperties.Name="Ouvrir l'espace d'étude" ToolTip="Sélectionnez d'abord un projet dans la liste"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource MkrSurface}"
                    BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" CornerRadius="8"
                    Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Nouveau projet" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Text="Donnez un nom explicite à votre étude."
                               Foreground="{DynamicResource MkrMuted}" Margin="0,5,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Content="_Nom du projet" Target="{Binding ElementName=ProjectName}"
                                   Padding="0" Margin="0,0,0,4" FontWeight="SemiBold"/>
                            <TextBox x:Name="ProjectName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="120" AutomationProperties.Name="Nom du nouveau projet"
                                     ToolTip="Nom du projet (120 caractères maximum)"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource MkrPrimaryButton}"
                                Content="_Créer le projet" Command="{Binding CreateProject}"
                                VerticalAlignment="Bottom" Margin="12,0,0,0"
                                AutomationProperties.Name="Créer le projet"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Background="{DynamicResource MkrSurface}"
                    BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" CornerRadius="8"
                    Padding="16" MinHeight="120">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Projets enregistrés" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Sélectionnez une ligne, puis ouvrez le projet."
                                   Foreground="{DynamicResource MkrMuted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="ProjectList" Grid.Row="1" SelectionChanged="ProjectSelected" MouseDoubleClick="OpenProject"
                              ItemsSource="{Binding Projects}"
                              AlternationCount="2"
                              AlternatingRowBackground="{DynamicResource MkrCanvas}"
                              AutomationProperties.Name="Projets enregistrés"
                              SelectionMode="Single" IsReadOnly="True" CanUserAddRows="False"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Projet" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Création (UTC)"
                                                Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                                Width="165"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Les projets sont enregistrés localement."
                                   Foreground="{DynamicResource MkrMuted}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Style="{StaticResource MkrPrimaryButton}"
                                Content="_Ouvrir le projet sélectionné" Click="OpenProject"
                                AutomationProperties.Name="Ouvrir le projet sélectionné"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!-- Espace d'étude : navigation à gauche, titre et étapes, barre d'écran, contenu -->
        <Grid x:Name="StudyView" Grid.Row="3" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TabStrip" Margin="6,10,6,10"/>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="TitleBar" Grid.Row="0" Margin="14,6,10,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="ScreenTitle" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" AutomationProperties.LiveSetting="Polite"/>
                    <Grid x:Name="Stages" Grid.Column="1" Height="34" HorizontalAlignment="Stretch"/>
                </Grid>
                <Border x:Name="RibbonHost" Grid.Row="1" Background="{DynamicResource MkrSurfaceAlt}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="0,1,0,1" Padding="10,4" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel x:Name="RibbonCommands" Orientation="Horizontal"/>
                        <TextBlock x:Name="RibbonNote" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="{DynamicResource MkrMuted}"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="ValuesColumn" Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="10,8,10,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton x:Name="ShowTraining" Content="Essai d'estimation" GroupName="Trial" IsChecked="True" Checked="TrialChanged" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="ShowValidation" Content="Essai de validation" GroupName="Trial" Checked="TrialChanged" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <local:SignalChart x:Name="Chart" Grid.Row="1" MinHeight="260" AutomationProperties.Name="Mesure observée et modèle, sortie de commande, en fonction du temps"
                            AutomationProperties.HelpText="Molette : zoom. Clic droit glissé : déplacement. Double-clic ou touche Origine : vue complète. Flèches : déplacement."/>
                        <TextBlock x:Name="CursorText" Grid.Row="2" Text="Survolez le graphique pour lire les valeurs au curseur." Foreground="{DynamicResource MkrMuted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <ScrollViewer x:Name="ValuesPanel" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,8,10,6">
                        <StackPanel>
                            <Expander Style="{StaticResource MkrPanel}" Header="Validation du modèle">
                                <StackPanel Margin="10,8">
                                    <Border x:Name="Verdict" CornerRadius="3" Padding="10,5" Margin="0,0,0,8" Background="{DynamicResource MkrBorderStrong}">
                                        <TextBlock x:Name="VerdictText" Text="AUCUNE ÉTUDE" FontWeight="Bold" Foreground="{DynamicResource MkrOnStatus}"/>
                                    </Border>
                                    <Label Content="É_tude affichée" Target="{Binding ElementName=StudyPicker}" Padding="0,0,0,2"/>
                                    <ComboBox x:Name="StudyPicker" DisplayMemberPath="Label" SelectionChanged="PickerChanged" AutomationProperties.Name="Étude affichée"/>
                                    <TextBlock x:Name="ValuesNote" TextWrapping="Wrap" Foreground="{DynamicResource MkrMuted}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Expander>
                            <Expander Style="{StaticResource MkrPanel}" Header="Paramètres du modèle">
                                <TextBlock x:Name="ValuesText" TextWrapping="Wrap" Margin="10,8" LineHeight="22"/>
                            </Expander>
                            <Expander Style="{StaticResource MkrPanel}" Header="Projet">
                                <TextBlock x:Name="InspectorFacts" TextWrapping="Wrap" Margin="10,8" Foreground="{DynamicResource MkrMuted}"/>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Contenu de l'étape affiché dans la fenêtre (réglage guidé, simulation…) : recouvre le graphique quand l'étape a sa propre vue -->
                    <Border x:Name="StepHost" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource MkrCanvas}"/>
                </Grid>
                <Border x:Name="StudyTablePanel" Grid.Row="1" Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="0,1,0,0">
                    <Grid Margin="10,6,10,6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Button x:Name="TableToggle" Content="▸ Tableau des études d'identification" Click="ToggleTable" HorizontalAlignment="Left" Margin="0,0,0,4" Padding="8,3"
                                AutomationProperties.Name="Afficher ou masquer le tableau des études"/>
                        <DataGrid x:Name="StudyGrid" Grid.Row="1" Height="130" Visibility="Collapsed" RowHeight="26" ColumnHeaderHeight="26" SelectionChanged="StudySelected" AutomationProperties.Name="Études d'identification du projet">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Famille" Binding="{Binding Family}" Width="90"/>
                                <DataGridTextColumn Header="Gain K" Binding="{Binding Gain}" Width="*"/>
                                <DataGridTextColumn Header="Constante τ (s)" Binding="{Binding Tau}" Width="*"/>
                                <DataGridTextColumn Header="Retard θ (s)" Binding="{Binding Delay}" Width="*"/>
                                <DataGridTextColumn Header="Erreur de validation" Binding="{Binding Error}" Width="*"/>
                                <DataGridTextColumn Header="Décision" Binding="{Binding Decision}" Width="110"/>
                                <DataGridTextColumn Header="Calculée" Binding="{Binding When}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
    
                </Grid>
            </Grid>
        </Grid>
        <!-- Barre d'état : état, faits du projet, étape suivante -->
        <Border Grid.Row="4" Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MkrSuccess}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <TextBlock x:Name="StatusFacts" Grid.Column="1" Margin="22,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource MkrMuted}" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="NextButton" Grid.Column="2" Style="{StaticResource MkrPrimaryButton}" Click="GoToNext" Visibility="Collapsed" MinHeight="32" Padding="16,4"
                        AutomationProperties.Name="Aller à la prochaine étape"/>
                <TextBlock Grid.Column="3" x:Name="VersionText" Foreground="{DynamicResource MkrMuted}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>