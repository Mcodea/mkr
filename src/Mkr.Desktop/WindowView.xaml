<Window x:Class="Mkr.Desktop.WindowView" Title="MKR — Espace projets"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1120" Height="740" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource MkrNavy}">
            <DockPanel Margin="20,24,16,18" LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="MKR" FontSize="31" FontWeight="Bold" Foreground="{DynamicResource MkrNavyText}"/>
                    <TextBlock Text="INGÉNIERIE DE RÉGULATION" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource MkrNavyMuted}" TextWrapping="Wrap" Margin="0,3,0,28"/>
                    <Border Background="{DynamicResource MkrNavySoft}" Padding="12,12" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="ESPACE DE TRAVAIL" Foreground="{DynamicResource MkrNavyMuted}" FontSize="10"
                                       FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock Text="Projets" Foreground="{DynamicResource MkrNavyText}" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Text="Création, sélection et ouverture d'une étude"
                                       Foreground="{DynamicResource MkrNavyText}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button Content="_Catalogue des blocs" Click="OpenCatalogue" Margin="0,12,0,0"
                            AutomationProperties.Name="Ouvrir le catalogue des blocs"/>
                    <TextBlock Text="PARCOURS D'INGÉNIERIE" Foreground="{DynamicResource MkrNavyMuted}" FontSize="10"
                               FontWeight="SemiBold" Margin="2,28,0,13"/>
                    <TextBlock Text="01   Boucle et objectif" Foreground="{DynamicResource MkrNavyText}" Margin="2,0,0,13"/>
                    <TextBlock Text="02   Acquisition et qualité" Foreground="{DynamicResource MkrNavyMuted}" Margin="2,0,0,13"/>
                    <TextBlock Text="03   Identification" Foreground="{DynamicResource MkrNavyMuted}" Margin="2,0,0,13"/>
                    <TextBlock Text="04   Réglage et simulation" Foreground="{DynamicResource MkrNavyMuted}" Margin="2,0,0,13"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="05   Préparation des essais sur banc" Foreground="{DynamicResource MkrNavyMuted}" TextWrapping="Wrap" Margin="2,0,0,13"/>
                    <TextBlock Text="06   Fiche et séries enregistrées" Foreground="{DynamicResource MkrNavyMuted}" TextWrapping="Wrap" Margin="2,0,0,13"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Label Content="_Thème" Target="{Binding ElementName=ThemeChoice}" Padding="0,0,0,4" Foreground="{DynamicResource MkrNavyMuted}"/>
                    <ComboBox x:Name="ThemeChoice" SelectionChanged="ThemeChanged" Margin="0,0,0,12"
                              AutomationProperties.Name="Thème de l'interface">
                        <ComboBoxItem Content="Suivre Windows" Tag="System"/>
                        <ComboBoxItem Content="Clair" Tag="Light"/>
                        <ComboBoxItem Content="Sombre" Tag="Dark"/>
                    </ComboBox>
                    <TextBlock Text="MKR  ·  Application Windows" Foreground="{DynamicResource MkrNavyMuted}" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28,23,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PROJETS / ACCUEIL" Foreground="{DynamicResource MkrAccent}"
                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Mes projets" FontWeight="SemiBold" FontSize="29"/>
                    <TextBlock Text="Créez ou sélectionnez un projet pour accéder aux données et aux études."
                               Foreground="{DynamicResource MkrMuted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Top" BorderBrush="{DynamicResource MkrBorder}"
                        BorderThickness="1" Background="{DynamicResource MkrSurface}" CornerRadius="5"
                        Padding="10,7" Margin="14,5,0,0">
                    <TextBlock Text="Espace local" Foreground="{DynamicResource MkrMuted}" FontSize="11"/>
                </Border>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource MkrSurface}"
                    BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" CornerRadius="8"
                    Padding="18" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Nouveau projet" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Text="Donnez un nom explicite à votre étude."
                               Foreground="{DynamicResource MkrMuted}" Margin="0,5,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Content="_Nom du projet" Target="{Binding ElementName=ProjectName}"
                                   Padding="0" Margin="0,0,0,4" FontWeight="SemiBold"/>
                            <TextBox x:Name="ProjectName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="120" AutomationProperties.Name="Nom du nouveau projet"
                                     ToolTip="Nom du projet (120 caractères maximum)"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource MkrPrimaryButton}"
                                Content="_Créer le projet" Command="{Binding CreateProject}"
                                VerticalAlignment="Bottom" Margin="12,0,0,0"
                                AutomationProperties.Name="Créer le projet"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Background="{DynamicResource MkrSurface}"
                    BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" CornerRadius="8"
                    Padding="16" MinHeight="120">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Projets enregistrés" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Sélectionnez une ligne, puis ouvrez le projet."
                                   Foreground="{DynamicResource MkrMuted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="ProjectList" Grid.Row="1"
                              ItemsSource="{Binding Projects}"
                              AlternationCount="2"
                              AlternatingRowBackground="{DynamicResource MkrCanvas}"
                              AutomationProperties.Name="Projets enregistrés"
                              SelectionMode="Single" IsReadOnly="True" CanUserAddRows="False"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Projet" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Création (UTC)"
                                                Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                                Width="165"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Les projets sont enregistrés localement."
                                   Foreground="{DynamicResource MkrMuted}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Style="{StaticResource MkrPrimaryButton}"
                                Content="_Ouvrir le projet sélectionné" Click="OpenProject"
                                AutomationProperties.Name="Ouvrir le projet sélectionné"/>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Row="3" BorderBrush="{DynamicResource MkrBorder}"
                    BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource MkrMuted}" Margin="0,0,12,0"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Button Grid.Column="1" Content="_Vérifier le moteur Python"
                            Command="{Binding CheckEngine}"
                            ToolTip="Vérifier la disponibilité du moteur scientifique local"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>