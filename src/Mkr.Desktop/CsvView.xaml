<UserControl x:Class="Mkr.Desktop.CsvView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mkr.Desktop">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="MKR  /  PROJET  /  DONNÉES"
                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MkrAccent}"/>
                <TextBlock Text="Étude de régulation" FontSize="27" FontWeight="SemiBold"
                           Margin="0,7,0,3"/>
                <TextBlock Text="Décrivez la boucle dans Procédé, puis sélectionnez les données pour identifier le modèle et comparer les réglages."
                           Foreground="{DynamicResource MkrMuted}" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="1" Padding="12,7" Margin="12,0,0,0"
                    BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1"
                    Background="{DynamicResource MkrSurface}" CornerRadius="5"
                    VerticalAlignment="Top">
                <TextBlock Text="CSV et acquisition en lecture seule" Foreground="{DynamicResource MkrMuted}"
                           FontSize="11"/>
            </Border>
        </Grid>
        <TabControl x:Name="Tabs" Grid.Row="1" Background="{DynamicResource MkrSurface}"
                    BorderBrush="{DynamicResource MkrBorder}" Padding="2">
            <TabItem Header="_Données CSV">
                <!-- One scrolling column: nothing can overlap, whatever the window height (the former fixed rows overlapped at 768 px). -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="14">
                    <StackPanel>
                        <StackPanel x:Name="Controls">
                            <Border BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1"
                                    Background="{DynamicResource MkrCanvas}" CornerRadius="6"
                                    Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="01  ·  Source et format du fichier" FontSize="15"
                                               FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Label Content="_Séparateur" Target="{Binding ElementName=Delimiter}"
                                               VerticalAlignment="Center"/>
                                        <ComboBox x:Name="Delimiter" Width="145" SelectedIndex="0"
                                                  SelectedValuePath="Tag" VerticalAlignment="Center">
                                            <ComboBoxItem Content="Virgule" Tag=","/>
                                            <ComboBoxItem Content="Point-virgule" Tag=";"/>
                                        </ComboBox>
                                        <Label Content="_Décimale" Target="{Binding ElementName=DecimalSeparator}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <ComboBox x:Name="DecimalSeparator" Width="90" SelectedIndex="0"
                                                  SelectedValuePath="Tag" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Séparateur décimal">
                                            <ComboBoxItem Content="Point" Tag="."/>
                                            <ComboBoxItem Content="Virgule" Tag=","/>
                                        </ComboBox>
                                        <Label Content="_Date et heure" Target="{Binding ElementName=TimeFormat}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <ComboBox x:Name="TimeFormat" Width="250" SelectedIndex="0"
                                                  SelectedValuePath="Tag" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Notation de la date et de l’heure"/>
                                        <Label Content="_Fuseau" Target="{Binding ElementName=TimeZone}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBox x:Name="TimeZone" Width="140" Text="Europe/Paris" IsEnabled="False"
                                                 ToolTip="Nom IANA du fuseau de l’enregistreur, par exemple Europe/Paris ou UTC"
                                                 AutomationProperties.Name="Fuseau horaire"/>
                                        <Button Content="Acquisition _automate…" Click="OpenAcquisition" Margin="12,0,0,0" ToolTip="Schneider (Modbus TCP) ou Siemens (S7comm), en lecture seule"/>
                                        <Button Content="_Choisir un CSV…" Click="ChooseCsv"
                                                Margin="12,0,0,0" ToolTip="Importer un fichier CSV en UTF-8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1"
                                    Background="{DynamicResource MkrSurface}" CornerRadius="6"
                                    Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="02  ·  Correspondance des variables"
                                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBlock Text="Sélectionnez explicitement les colonnes, le rôle métier et l’unité physique. Aucun rôle n’est déduit automatiquement."
                                               Foreground="{DynamicResource MkrMuted}"
                                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,12,8">
                                            <Label Content="_Horodatage" Target="{Binding ElementName=TimeColumn}"
                                                   Padding="0" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="TimeColumn" Width="185" MinHeight="34"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,8">
                                            <Label Content="_Valeur" Target="{Binding ElementName=ValueColumn}"
                                                   Padding="0" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="ValueColumn" Width="185" MinHeight="34"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,8">
                                            <Label Content="_Rôle" Target="{Binding ElementName=Role}"
                                                   Padding="0" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="Role" Width="190" MinHeight="34"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,8">
                                            <Label Content="_Unité" Target="{Binding ElementName=Unit}"
                                                   Padding="0" Margin="0,0,0,4"/>
                                            <TextBox x:Name="Unit" Width="112" MaxLength="40"/>
                                        </StackPanel>
                                        <Button x:Name="Analyze" Content="_Analyser et enregistrer"
                                                Click="AnalyzeCsv" IsEnabled="False" VerticalAlignment="Bottom"
                                                Margin="0,0,0,8" Style="{StaticResource MkrPrimaryButton}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1"
                                    Background="{DynamicResource MkrSurface}" CornerRadius="6"
                                    Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="03  ·  Imports enregistrés" FontSize="15"
                                               FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Label Content="_Imports enregistrés"
                                               Target="{Binding ElementName=Imports}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="Imports" Width="280" MinHeight="34"
                                                  DisplayMemberPath="Label" VerticalAlignment="Center"/>
                                        <Button Content="_Ouvrir" Click="OpenImport" Margin="10,0,0,0"/>
                                        <Button Content="Exporter l’_original…" Click="ExportOriginal"
                                                Margin="8,0,0,0"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    <Border BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1"
                            CornerRadius="6" Background="{DynamicResource MkrSurface}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Aperçu du fichier" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="Lignes source affichées sans modification des valeurs brutes."
                                           Foreground="{DynamicResource MkrMuted}" Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <DataGrid Grid.Row="1" x:Name="Preview" IsReadOnly="True" Height="260"
                                      CanUserAddRows="False" AutoGenerateColumns="False"
                                      AutomationProperties.Name="Aperçu des données CSV"/>
                        </Grid>
                    </Border>
                    <Border Margin="0,12,0,0" Padding="12"
                            BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1"
                            Background="{DynamicResource MkrAccentPale}" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Qualité et provenance" FontSize="13"
                                       FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="Report" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MkrText}"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="_Procédé">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Boucle et objectif de régulation" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Indiquez le repère de la boucle, la grandeur régulée, le point de fonctionnement habituel avec son unité et le résultat recherché." TextWrapping="Wrap"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Label Content="Repère de la boucle" Target="{Binding ElementName=LoopTag}"/>
                            <TextBox x:Name="LoopTag"/>
                            <Label Content="Grandeur régulée" Target="{Binding ElementName=LoopControlledQuantity}"/>
                            <TextBox x:Name="LoopControlledQuantity"/>
                            <Label Content="Point de fonctionnement et unité" Target="{Binding ElementName=LoopOperatingPoint}"/>
                            <TextBox x:Name="LoopOperatingPoint"/>
                            <Label Content="Objectif de régulation" Target="{Binding ElementName=LoopObjective}"/>
                            <TextBox x:Name="LoopObjective"/>
                            <Label Content="Description du procédé" Target="{Binding ElementName=Description}"/>
                            <TextBox x:Name="Description" MinHeight="80" AcceptsReturn="True" MaxLength="4000"
                                     TextWrapping="Wrap" AutomationProperties.Name="Description du procédé"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="_Enregistrer la description"
                            Click="SaveDescription" HorizontalAlignment="Left"
                            Margin="0,12,0,0" Style="{StaticResource MkrPrimaryButton}"/>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" BorderBrush="{DynamicResource MkrBorder}"
                BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource MkrMuted}"
                           AutomationProperties.LiveSetting="Polite"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Préparer les essais sur _banc…" Click="OpenCatalogue" Margin="0,0,8,0"
                            ToolTip="Consulter les fiches constructeur et préparer le relevé de banc"/>
                    <Button Content="Journal d'_audit…" Click="OpenAudit" Margin="0,0,8,0"
                            ToolTip="Actions sensibles du projet, chaînées par empreintes"/>
                    <Button Content="_Identification…" Click="OpenIdentification"
                        Style="{StaticResource MkrPrimaryButton}"
                        ToolTip="Ouvrir les études d’identification du projet"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>