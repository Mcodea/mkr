<UserControl x:Class="Mkr.Desktop.CsvView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mkr.Desktop">
    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Données de l’étude · CSV et acquisition en lecture seule" Foreground="{DynamicResource MkrMuted}" Margin="2,0,0,6"/>
        <TabControl x:Name="Tabs" Grid.Row="1" Background="{DynamicResource MkrSurface}"
                    BorderBrush="{DynamicResource MkrBorder}" Padding="2">
            <TabItem Header="_Données CSV">
                <!-- One scrolling column: nothing can overlap, whatever the window height (the former fixed rows overlapped at 768 px). -->
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="430" MinWidth="320" MaxWidth="700"/>
                    </Grid.ColumnDefinitions>
                    <TabControl x:Name="DataTabs" Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}" Padding="0">
                        <TabItem Header="_Tendances" AutomationProperties.Name="Tendances des signaux">
                            <Grid Margin="6">
                                <local:SignalChart x:Name="TrendChart" ReferenceStyle="True" ShowValueBoxes="False" MinHeight="200"
                                        AutomationProperties.Name="Tendances des signaux du fichier, en fonction du temps"
                                        AutomationProperties.HelpText="Molette : zoom. Clic droit glissé : déplacement. Double-clic ou touche Origine : vue complète. Flèches : déplacement."/>
                                <TextBlock x:Name="TrendEmpty" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"
                                           Foreground="{DynamicResource MkrMuted}" IsHitTestVisible="False"
                                           Text="Aucune donnée à tracer. Choisissez un CSV, lancez une acquisition en lecture seule ou ouvrez un import enregistré (panneau de droite) : les colonnes numériques s’affichent ici, valeurs brutes inchangées."/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Données _brutes" AutomationProperties.Name="Données brutes">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Lignes source, valeurs brutes inchangées" FontWeight="SemiBold" Margin="2,0,0,6"/>
                                <DataGrid Grid.Row="1" x:Name="Preview" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False"
                                          AutomationProperties.Name="Aperçu des données CSV"/>
                                <TextBlock Grid.Row="1" x:Name="PreviewEmpty" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"
                                           Foreground="{DynamicResource MkrMuted}" IsHitTestVisible="False"
                                           Text="Aucune ligne à afficher.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=Preview, Path=HasItems}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </TabItem>
                    </TabControl>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Redimensionner le panneau"/>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="Controls">
                            <Expander Style="{StaticResource MkrPanel}" Header="État et synthèse des données">
                                <StackPanel Margin="10,8">
                                    <Border x:Name="StateBadge" CornerRadius="3" Padding="10,6" Margin="0,0,0,8" Background="{DynamicResource MkrSurfaceAlt}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1">
                                        <TextBlock x:Name="StateText" FontWeight="SemiBold" Text="Aucune donnée" AutomationProperties.LiveSetting="Polite"/>
                                    </Border>
                                    <Grid x:Name="SummaryGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions></Grid>
                                </StackPanel>
                            </Expander>
                            <Expander Style="{StaticResource MkrPanel}" Header="Signaux affichés">
                                <StackPanel x:Name="SignalPicker" Margin="10,8">
                                    <TextBlock x:Name="SignalHint" Text="Les colonnes numériques du fichier apparaissent ici une fois les données ouvertes." TextWrapping="Wrap" Foreground="{DynamicResource MkrMuted}"/>
                                </StackPanel>
                            </Expander>
                            <Expander Style="{StaticResource MkrPanel}" Header="Source et format du fichier">
                                <StackPanel Margin="10,8">
<Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Content="_Séparateur" Target="{Binding ElementName=Delimiter}" VerticalAlignment="Center" Padding="0,0,12,0" Margin="0,0,0,6"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="Delimiter" SelectedIndex="0" SelectedValuePath="Tag" VerticalAlignment="Center" Margin="0,0,0,6">
                                            <ComboBoxItem Content="Virgule" Tag=","/>
                                            <ComboBoxItem Content="Point-virgule" Tag=";"/>
                                        </ComboBox>
                                        <Label Grid.Row="1" Content="_Décimale" Target="{Binding ElementName=DecimalSeparator}" VerticalAlignment="Center" Padding="0,0,12,0" Margin="0,0,0,6"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DecimalSeparator" SelectedIndex="0" SelectedValuePath="Tag" VerticalAlignment="Center" Margin="0,0,0,6"
                                                  AutomationProperties.Name="Séparateur décimal">
                                            <ComboBoxItem Content="Point" Tag="."/>
                                            <ComboBoxItem Content="Virgule" Tag=","/>
                                        </ComboBox>
                                        <Label Grid.Row="2" Content="_Date et heure" Target="{Binding ElementName=TimeFormat}" VerticalAlignment="Center" Padding="0,0,12,0" Margin="0,0,0,6"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="TimeFormat" SelectedIndex="0" SelectedValuePath="Tag" VerticalAlignment="Center" Margin="0,0,0,6"
                                                  AutomationProperties.Name="Notation de la date et de l’heure"/>
                                        <Label Grid.Row="3" Content="_Fuseau" Target="{Binding ElementName=TimeZone}" VerticalAlignment="Center" Padding="0,0,12,0" Margin="0,0,0,8"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TimeZone" Text="Europe/Paris" IsEnabled="False" Margin="0,0,0,8"
                                                 ToolTip="Nom IANA du fuseau de l’enregistreur, par exemple Europe/Paris ou UTC"
                                                 AutomationProperties.Name="Fuseau horaire"/>
                                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal">
                                            <Button Content="Acquisition _automate…" Click="OpenAcquisition" ToolTip="Schneider (Modbus TCP) ou Siemens (S7comm), en lecture seule"/>
                                            <Button Content="_Choisir un CSV…" Click="ChooseCsv" Margin="8,0,0,0" ToolTip="Importer un fichier CSV en UTF-8"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                            <Expander Style="{StaticResource MkrPanel}" Header="Correspondance des variables">
                                <StackPanel Margin="10,8">
                                    <TextBlock Text="Sélectionnez explicitement les colonnes, le rôle métier et l’unité physique. Aucun rôle n’est déduit automatiquement."
                                               Foreground="{DynamicResource MkrMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
<Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Margin="0,0,0,8">
                                            <Label Content="_Horodatage" Target="{Binding ElementName=TimeColumn}" Padding="0" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="TimeColumn" MinHeight="34"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,0,8">
                                            <Label Content="_Valeur" Target="{Binding ElementName=ValueColumn}" Padding="0" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="ValueColumn" MinHeight="34"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                            <Label Content="_Rôle" Target="{Binding ElementName=Role}" Padding="0" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="Role" MinHeight="34"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                            <Label Content="_Unité" Target="{Binding ElementName=Unit}" Padding="0" Margin="0,0,0,4"/>
                                            <TextBox x:Name="Unit" MaxLength="40" MinHeight="34"/>
                                        </StackPanel>
                                        <Button Grid.Row="2" Grid.ColumnSpan="3" x:Name="Analyze" Content="_Analyser et enregistrer" Click="AnalyzeCsv" IsEnabled="False"
                                                HorizontalAlignment="Left" Style="{StaticResource MkrPrimaryButton}"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                            <Expander Style="{StaticResource MkrPanel}" Header="Imports enregistrés">
                                <StackPanel Margin="10,8">
<StackPanel>
                                        <Label Content="_Imports enregistrés" Target="{Binding ElementName=Imports}" Padding="0" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="Imports" MinHeight="34" DisplayMemberPath="Label" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="_Ouvrir" Click="OpenImport"/>
                                            <Button Content="Exporter l’_original…" Click="ExportOriginal" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                            <Expander Style="{StaticResource MkrPanel}" Header="Qualité et provenance">
                                <TextBlock x:Name="Report" TextWrapping="Wrap" Margin="10,8" Foreground="{DynamicResource MkrText}"/>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="_Procédé">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Boucle et objectif de régulation" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Indiquez le repère de la boucle, la grandeur régulée, le point de fonctionnement habituel avec son unité et le résultat recherché." TextWrapping="Wrap"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Label Content="Repère de la boucle" Target="{Binding ElementName=LoopTag}"/>
                            <TextBox x:Name="LoopTag"/>
                            <Label Content="Grandeur régulée" Target="{Binding ElementName=LoopControlledQuantity}"/>
                            <TextBox x:Name="LoopControlledQuantity"/>
                            <Label Content="Point de fonctionnement et unité" Target="{Binding ElementName=LoopOperatingPoint}"/>
                            <TextBox x:Name="LoopOperatingPoint"/>
                            <Label Content="Objectif de régulation" Target="{Binding ElementName=LoopObjective}"/>
                            <TextBox x:Name="LoopObjective"/>
                            <Label Content="Description du procédé" Target="{Binding ElementName=Description}"/>
                            <TextBox x:Name="Description" MinHeight="80" AcceptsReturn="True" MaxLength="4000"
                                     TextWrapping="Wrap" AutomationProperties.Name="Description du procédé"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="_Enregistrer la description"
                            Click="SaveDescription" HorizontalAlignment="Left"
                            Margin="0,12,0,0" Style="{StaticResource MkrPrimaryButton}"/>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" BorderBrush="{DynamicResource MkrBorder}"
                BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource MkrMuted}"
                           AutomationProperties.LiveSetting="Polite"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Préparer les essais sur _banc…" Click="OpenCatalogue" Margin="0,0,8,0"
                            ToolTip="Consulter les fiches constructeur et préparer le relevé de banc"/>
                    <Button Content="Journal d'_audit…" Click="OpenAudit" Margin="0,0,8,0"
                            ToolTip="Actions sensibles du projet, chaînées par empreintes"/>
                    <Button Content="_Identification…" Click="OpenIdentification"
                        Style="{StaticResource MkrPrimaryButton}"
                        ToolTip="Ouvrir les études d’identification du projet"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>