<Window x:Class="Mkr.Desktop.AboutWindow" Title="{local:Loc ui.orias_a_propos}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mkr.Desktop"
        AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource Self}}"
        Width="640" Height="620" MinWidth="460" MinHeight="420" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="26,22,26,18">
        <Button DockPanel.Dock="Bottom" Content="{local:Loc about.close}" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Margin="0,14,0,0" Click="Close"
                AutomationProperties.Name="{local:Loc ui.fermer_la_fenetre_a_propos}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Image Source="{DynamicResource OriasLogo}" Height="64" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="ORIAS"/>
                <TextBlock x:Name="Tagline" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MkrAccent}" Margin="0,10,0,2"/>
                <TextBlock x:Name="Meaning" TextWrapping="Wrap" Foreground="{DynamicResource MkrMuted}" Margin="0,0,0,14"/>
                <TextBlock x:Name="Description" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <TextBlock Text="{local:Loc about.version}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                <TextBlock x:Name="VersionLine" TextWrapping="Wrap" Margin="0,0,0,2"/>
                <TextBlock x:Name="TechnicalLine" TextWrapping="Wrap" Foreground="{DynamicResource MkrMuted}" Margin="0,0,0,16"/>
                <TextBlock Text="{local:Loc about.qualification.title}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                <TextBlock x:Name="Qualification" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <TextBlock Text="{local:Loc about.thirdparty.title}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                <TextBlock x:Name="ThirdParty" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <TextBlock Text="{local:Loc about.legal.title}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                <TextBlock Text="{local:Loc about.legal.text}" TextWrapping="Wrap" Foreground="{DynamicResource MkrMuted}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
