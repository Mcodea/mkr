<Application x:Class="Mkr.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- MKR UI-01: centralised, semantic tokens; light industrial desktop theme. -->
        <SolidColorBrush x:Key="MkrNavy" Color="#15243B"/>
        <SolidColorBrush x:Key="MkrNavySoft" Color="#243953"/>
        <SolidColorBrush x:Key="MkrCanvas" Color="#F3F6FA"/>
        <SolidColorBrush x:Key="MkrSurface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MkrBorder" Color="#D8E0EA"/>
        <SolidColorBrush x:Key="MkrText" Color="#1B293D"/>
        <SolidColorBrush x:Key="MkrMuted" Color="#546579"/>
        <SolidColorBrush x:Key="MkrAccent" Color="#1769AA"/>
        <SolidColorBrush x:Key="MkrAccentPale" Color="#EAF3FA"/>
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource MkrText}"/>
            <Setter Property="Background" Value="{StaticResource MkrCanvas}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="BorderBrush" Value="{StaticResource MkrBorder}"/>
            <Setter Property="Background" Value="{StaticResource MkrSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource MkrText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- Visible states: hover, pressed, keyboard focus (thick accent border), disabled. RecognizesAccessKey keeps the Alt+letter keys. -->
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource MkrAccent}"/>
                                <Setter TargetName="Root" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource MkrAccent}"/>
                                <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource MkrBorder}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- Flat control consistent with buttons and text boxes. Standard parts only: UI Automation (expand, items) is unchanged. -->
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Frame" Background="{StaticResource MkrSurface}" BorderBrush="{StaticResource MkrBorder}"
                                                BorderThickness="1" CornerRadius="5">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource MkrMuted}" StrokeThickness="1.6"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource MkrAccent}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource MkrAccent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- ContentSource also carries the template selector that implements DisplayMemberPath in the selection box. -->
                            <ContentPresenter IsHitTestVisible="False" Margin="10,0,30,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              ContentSource="SelectionBoxItem"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=Toggle}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource MkrSurface}" BorderBrush="{StaticResource MkrBorder}" BorderThickness="1"
                                        CornerRadius="4" Margin="0,2,6,6" Padding="2">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource MkrAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource MkrText}"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource MkrBorder}"/>
            <Setter Property="Background" Value="{StaticResource MkrSurface}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <!-- Only the header is bold; the content keeps the normal weight. -->
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="SemiBold"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="MkrPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource MkrAccent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MkrAccent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="BorderBrush" Value="{StaticResource MkrBorder}"/>
            <Setter Property="Background" Value="{StaticResource MkrSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource MkrText}"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource MkrSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource MkrText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MkrBorder}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource MkrBorder}"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource MkrAccentPale}"/>
            <Setter Property="Foreground" Value="{StaticResource MkrText}"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
    </Application.Resources>
</Application>