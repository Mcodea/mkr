<UserControl x:Class="Mkr.Desktop.IdentificationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mkr.Desktop">
    <Grid Margin="8,6,8,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource MkrSurfaceAlt}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" Padding="8,4">
            <Border.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="10,2"/></Style>
<Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6,2"/></Style>
<Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6,2"/></Style></Border.Resources>
            <WrapPanel x:Name="Form0">
                <Label Content="_Modèle" Target="{Binding ElementName=FamilyChoice}" VerticalAlignment="Center"/>
                <ComboBox x:Name="FamilyChoice" Width="95" Margin="0,0,10,0" VerticalAlignment="Center" AutomationProperties.Name="Famille de modèle"/>
                <Label Content="_Étude" Target="{Binding ElementName=StudyList}" VerticalAlignment="Center"/>
                <ComboBox x:Name="StudyList" Width="300" DisplayMemberPath="Label" SelectionChanged="ShowStudy" VerticalAlignment="Center" AutomationProperties.Name="Études">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                            <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id}"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <Button Content="_Estimer et enregistrer" Click="Calculate" Margin="12,0,0,0" Style="{StaticResource MkrPrimaryButton}" VerticalAlignment="Center"/>
                <Button Content="Es_sais et critères…" Click="ToggleTrials" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Ouvrir la page « Essais et actions » : choix des essais d'estimation et de validation, critères, réglage"/>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition x:Name="PanelColumn" Width="360" MinWidth="260" MaxWidth="640"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource MkrSurfaceAlt}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1,1,1,0" Padding="4,2">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="_Essai affiché" Target="{Binding ElementName=PlotSource}" VerticalAlignment="Center" Padding="4,0"/>
                        <ComboBox x:Name="PlotSource" Width="120" SelectedIndex="1" SelectionChanged="ChangePlotSource" VerticalAlignment="Center" MinHeight="26" Padding="6,1">
                            <ComboBoxItem Content="Estimation"/>
                            <ComboBoxItem Content="Validation"/>
                        </ComboBox>
                        <Border Width="1" Background="{DynamicResource MkrBorder}" Margin="8,3"/>
                        <Button Style="{StaticResource MkrToolButton}" Click="ResetPlotZoom" ToolTip="Vue complète : revenir à tout l’essai affiché" AutomationProperties.Name="Vue complète"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                        <Button Style="{StaticResource MkrToolButton}" Click="ExportPlotImage" ToolTip="Exporter le graphique en image PNG" AutomationProperties.Name="Exporter l’image"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                        <Button Style="{StaticResource MkrToolButton}" Click="ExportPlotData" ToolTip="Exporter les courbes affichées en CSV" AutomationProperties.Name="Exporter les données"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                        <Button Style="{StaticResource MkrToolButton}" Click="ToggleChartOnly" ToolTip="Donner toute la largeur au graphique, ou rétablir les panneaux" AutomationProperties.Name="Plein écran du graphique"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                        <Button Style="{StaticResource MkrToolButton}" Click="ClearWindow" ToolTip="Effacer la plage A–B (sélection : glisser avec le bouton gauche sur le graphique)" AutomationProperties.Name="Effacer la plage A–B"><TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                        
                    </StackPanel>
                </Border>
                <local:SignalChart x:Name="Chart" Grid.Row="1" MinHeight="300" ShowValueBoxes="False" SelectionEnabled="True"
                        AutomationProperties.Name="Mesure observée, mesure prédite, commande et résidus de l’essai sélectionné, en fonction du temps"
                        AutomationProperties.HelpText="Molette : zoom. Clic droit glissé : déplacement. Double-clic ou touche Origine : vue complète. Flèches : déplacement."/>
                <Grid Grid.Row="2" Margin="2,3,0,0" MinHeight="30">
                    <TextBlock x:Name="PlotLegend" TextWrapping="Wrap" Foreground="{DynamicResource MkrMuted}" FontSize="11"/>
                    <TextBlock x:Name="CursorText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11"/>
                </Grid>
            </Grid>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Redimensionner le panneau"/>
            <Grid x:Name="PanelScroll" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource MkrSurfaceAlt}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" Padding="4,3" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="PageResults" GroupName="IdentPage" IsChecked="True" Content="Résultats" Style="{StaticResource MkrPageTab}" Checked="PageChanged" AutomationProperties.AutomationId="PageResults"/>
                        <RadioButton x:Name="PageSetup" GroupName="IdentPage" Content="Essais et actions" Style="{StaticResource MkrPageTab}" Checked="PageChanged" AutomationProperties.AutomationId="PageSetup"/>
                    </StackPanel>
                </Border>
                <ScrollViewer x:Name="ResultsPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <Expander x:Name="ModelPanel" Style="{StaticResource MkrPanel}" Header="Modèle identifié">
                        <StackPanel Margin="10,8">
                            <StackPanel x:Name="FormulaHost" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4"/>
                            <TextBlock x:Name="FormulaFamily" Foreground="{DynamicResource MkrMuted}" TextAlignment="Center"/>
                        </StackPanel>
                    </Expander>
                    <Expander Style="{StaticResource MkrPanel}" Header="Paramètres du modèle">
                        <StackPanel x:Name="ParameterTable"/>
                    </Expander>
                    <Expander Style="{StaticResource MkrPanel}" Header="Qualité du modèle">
                        <StackPanel>
                            <StackPanel Margin="10,8,10,0">
                <Border x:Name="VerdictCard" Visibility="Collapsed" CornerRadius="3" Padding="8,6" Margin="0,0,0,6" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="VerdictBadge" CornerRadius="3" Padding="8,3" VerticalAlignment="Top" Margin="0,0,8,0">
                            <TextBlock x:Name="VerdictTitle" FontWeight="Bold" Foreground="{DynamicResource MkrOnStatus}"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="VerdictDetail" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11"/>
                            <WrapPanel x:Name="VerdictMetrics" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                                            </StackPanel>
                            <StackPanel x:Name="QualityTable"/>
                        </StackPanel>
                    </Expander>
                    <Expander Style="{StaticResource MkrPanel}" Header="Comparaison des modèles (études du projet)">
                        <DataGrid x:Name="ModelTable" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="26" ColumnHeaderHeight="30" MaxHeight="190"
                                  SelectionMode="Single" SelectionChanged="ModelTableChanged" AutomationProperties.Name="Comparaison des modèles">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Modèle" Binding="{Binding Family}" Width="1.2*"/>
                                <DataGridTextColumn Header="FIT (%)" Binding="{Binding Fit}" Width="*"/>
                                <DataGridTextColumn Header="RMSE" Binding="{Binding Rmse}" Width="*"/>
                                <DataGridTextColumn Header="Décision" Binding="{Binding Decision}" Width="1.3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Expander>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="SetupPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <Expander x:Name="TrialsPanel" Style="{StaticResource MkrPanel}" Header="Essais d'identification (estimation et validation)">
                        <StackPanel x:Name="Form" Margin="10,8">
                    <GroupBox Header="Estimation" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel Margin="6">
                            <Label Content="Import" Target="{Binding ElementName=TrainingSource}" />
                            <ComboBox x:Name="TrainingSource" Width="200" DisplayMemberPath="Label" SelectionChanged="SelectTraining" >
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <Label Content="Temps" Target="{Binding ElementName=TrainingTime}" />
                            <ComboBox x:Name="TrainingTime" Width="95" />
                            <Label Content="Sortie de commande" Target="{Binding ElementName=TrainingMv}" />
                            <ComboBox x:Name="TrainingMv" Width="95" />
                            <Label Content="Mesure" Target="{Binding ElementName=TrainingPv}" />
                            <ComboBox x:Name="TrainingPv" Width="95" />
                        </WrapPanel>
                        <Button Content="Afficher les _courbes brutes (estimation)…"
                                Click="PreviewTraining" HorizontalAlignment="Left"
                                Margin="12,0,12,8"
                                ToolTip="Sélectionner une plage du CSV original pour le prochain calcul"/>
                        <Button x:Name="FindTrials" Content="_Rechercher les essais exploitables dans cet enregistrement…"
                                Click="FindTrialsInRecording" HorizontalAlignment="Left" Margin="12,0,12,8"
                                ToolTip="Pour un historique long : repère les échelons propres de la sortie de commande et propose deux plages indépendantes"/>
                        <TextBlock x:Name="TrainingRangeInfo" Text="Estimation : fichier complet" Margin="12,0,8,8"
                                   Foreground="{DynamicResource MkrMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Validation" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel Margin="6">
                            <Label Content="Import" Target="{Binding ElementName=ValidationSource}" />
                            <ComboBox x:Name="ValidationSource" Width="200" DisplayMemberPath="Label" SelectionChanged="SelectValidation" >
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <Label Content="Temps" Target="{Binding ElementName=ValidationTime}" />
                            <ComboBox x:Name="ValidationTime" Width="95" />
                            <Label Content="Sortie de commande" Target="{Binding ElementName=ValidationMv}" />
                            <ComboBox x:Name="ValidationMv" Width="95" />
                            <Label Content="Mesure" Target="{Binding ElementName=ValidationPv}" />
                            <ComboBox x:Name="ValidationPv" Width="95" />
                        </WrapPanel>
                        <Button Content="Afficher les courbes brutes (_validation)…"
                                Click="PreviewValidation" HorizontalAlignment="Left"
                                Margin="12,0,12,8"
                                ToolTip="Sélectionner une plage indépendante pour la validation"/>
                        <TextBlock x:Name="ValidationRangeInfo" Text="Validation : fichier complet" Margin="12,0,8,8"
                                   Foreground="{DynamicResource MkrMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>
                    <WrapPanel Margin="0,0,0,8">
                        <Label Content="Unité de la sortie de commande" Target="{Binding ElementName=MvUnit}" />
                        <TextBox x:Name="MvUnit" Width="65" MaxLength="40" />
                        <Label Content="Tolérance de la sortie de commande (plateaux)" Target="{Binding ElementName=MvTolerance}" />
                        <TextBox x:Name="MvTolerance" Width="82" />
                        <Label Content="Unité de la mesure" Target="{Binding ElementName=PvUnit}" />
                        <TextBox x:Name="PvUnit" Width="65" MaxLength="40" />
                        <Label Content="Tolérance de la mesure avant échelon" Target="{Binding ElementName=PvTolerance}" />
                        <TextBox x:Name="PvTolerance" Width="82" />
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <Label Content="Erreur quadratique max. (RMSE, unité de la mesure)" Target="{Binding ElementName=MaximumRmse}"/>
                        <TextBox x:Name="MaximumRmse" Width="76"/>
                        <Label Content="Corrélation résiduelle maximale |r₁|" Target="{Binding ElementName=MaximumLag}"/>
                        <TextBox x:Name="MaximumLag" Width="76"/>
                        <Button x:Name="SuggestCriteria" Content="_Proposer les critères" Click="ProposeCriteria" Margin="0,0,8,0"
                                ToolTip="Calculés à partir du bruit mesuré sur les plateaux avant échelon, sans regarder l’ajustement"/>
                        <Button x:Name="CompareModels" Content="Comparer FOPDT et SOPDT" Click="Calculate"/>
                        <Button x:Name="ArxButton" Content="Identifier par ARX / _OE" Click="IdentifyArx" Margin="8,0,0,0"
                                ToolTip="Excitation quelconque, sans régime permanent initial ; essais en boucle ouverte, pas d'échantillonnage régulier. Chaque exécution est enregistrée comme étude ARX."/>
                        <Button x:Name="ArxTuneButton" Content="Réglage guidé depuis l'AR_X…" Click="TuneFromArx" Margin="8,0,0,0" IsEnabled="False"
                                ToolTip="Disponible après une étude ARX acceptée dont le modèle retenu est du premier ordre (ADR 0008)"/>
                    </WrapPanel>
                    <CheckBox x:Name="Confirmed" Margin="0,2,0,8">
                        <TextBlock TextWrapping="Wrap" Text="Les deux essais ont été réalisés en boucle ouverte, sans saturation connue, avec les mêmes unités et dans des conditions comparables." />
                    </CheckBox>
                        </StackPanel>
                    </Expander>
                    <Expander Style="{StaticResource MkrPanel}" Header="Réglage et actions sur le modèle accepté">
                        <StackPanel Margin="10,8">
                <Button x:Name="OpenLoopButton" Content="_Simuler en boucle ouverte…" Click="OpenLoop"
                        Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0" />
                <Button x:Name="ReviewButton" Content="_Revue de l'étude…" Click="OpenReview"
                        Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0"
                        ToolTip="Calculé, vérifié, approuvé : décisions attribuées à l'identité de la session, règle des quatre yeux."/>
                <Button x:Name="DriftButton" Content="_Vérifier le modèle sur un nouvel essai…" Click="CheckDrift"
                        Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0"
                        ToolTip="Choisissez le nouvel échelon en boucle ouverte dans la zone Validation, puis vérifiez si ce modèle accepté le décrit encore."/>
                <Button x:Name="IntegratorButton" Content="Régler le procédé _intégrateur…" Click="OpenIntegrator"
                        Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0"
                        ToolTip="PI par la règle SIMC des procédés intégrateurs, marges de la boucle nominale et valeurs du bloc PIDFF (non qualifiées)."/>
                <GroupBox x:Name="TargetPanel" Header="Comportement souhaité" Visibility="Collapsed" Margin="0,8,0,0">
                    <StackPanel Margin="8">
                        <WrapPanel>
                            <Label Content="Réponse" Target="{Binding ElementName=ResponseProfile}"/>
                            <ComboBox x:Name="ResponseProfile" SelectionChanged="ChangeResponseProfile" Width="180">
                                <ComboBoxItem Content="SIMC · réponse rapide"/>
                                <ComboBoxItem Content="Personnalisée"/>
                            </ComboBox>
                            <Label Content="Cible de calcul (s)" Target="{Binding ElementName=ResponseTarget}"/>
                            <TextBox x:Name="ResponseTarget" TextChanged="ResponseTargetChanged" Width="100"/>
                        </WrapPanel>
                        <TextBlock x:Name="TargetHelp" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="SopdtPanel" Header="Réglage PID théorique · SIMC" Visibility="Collapsed" Margin="0,8,0,0">
                    <StackPanel Margin="8">
                        <WrapPanel>
                            <Button x:Name="CalculatePidButton" IsEnabled="False" Content="Calculer le PID SIMC" Click="CalculateSopdt" Margin="8,0,0,0"/>
                        </WrapPanel>
                        <TextBlock x:Name="SopdtReport" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="PiPanel" Header="Réglages PI théoriques" Visibility="Collapsed" Margin="0,8,0,0">
                    <StackPanel Margin="8">
                        <WrapPanel>
                            <Button x:Name="ComparePiButton" IsEnabled="False" Content="_Comparer Lambda et SIMC" Click="CalculatePi" Margin="8,0,0,0" />
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Label Content="Réglages enregistrés" Target="{Binding ElementName=PiList}" />
                            <ComboBox x:Name="PiList" Width="245" DisplayMemberPath="Label" SelectionChanged="ShowPi" />
                            <Button x:Name="SimulateSavedPi" IsEnabled="False" Content="Simuler le réglage _enregistré…" Click="OpenSimulation" Margin="8,0,0,0" />
                            <Button x:Name="PidffValues" IsEnabled="False" Content="_Valeurs du bloc PIDFF…" Click="ShowPidffValues" Margin="8,0,0,0"
                                    ToolTip="Valeurs documentaires du bloc Schneider PIDFF (structure mixte). Non qualifiées."/>
                            <Button x:Name="OtherBlocks" IsEnabled="False" Content="Blocs PID__INT et PID__Compact…" Click="ShowOtherBlocks" Margin="8,0,0,0"
                                    ToolTip="Valeurs documentaires des blocs Schneider PID_INT et Siemens PID_Compact V2.x/V3.x. Non qualifiées."/>
                        </WrapPanel>
                        <TextBlock x:Name="PiReport" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </GroupBox>
                        </StackPanel>
                    </Expander>
                    <Expander Style="{StaticResource MkrPanel}" Header="Rapport détaillé de l'étude">
                        <StackPanel Margin="10,8">
                            <TextBlock x:Name="FitReport" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        <TextBlock x:Name="Message" Grid.Row="2" Margin="2,4,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</UserControl>
