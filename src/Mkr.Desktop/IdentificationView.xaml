<UserControl x:Class="Mkr.Desktop.IdentificationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mkr.Desktop">
    <UserControl.Resources>
        <local:StudyNameConverter x:Key="StudyName"/>
    </UserControl.Resources>
    <Grid Margin="8,6,8,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource MkrSurfaceAlt}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" Padding="8,4">
            <Border.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="10,2"/></Style>
<Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6,2"/></Style>
<Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6,2"/></Style></Border.Resources>
            <WrapPanel x:Name="Form0">
                <Label Content="{local:Loc ui.modele}" Target="{Binding ElementName=FamilyChoice}" VerticalAlignment="Center"/>
                <ComboBox x:Name="FamilyChoice" Width="95" Margin="0,0,10,0" VerticalAlignment="Center" AutomationProperties.Name="{local:Loc ui.famille_de_modele}"/>
                <Label Content="{local:Loc ui.etude}" Target="{Binding ElementName=StudyList}" VerticalAlignment="Center"/>
                <ComboBox x:Name="StudyList" Width="300" SelectionChanged="ShowStudy" VerticalAlignment="Center" AutomationProperties.Name="{local:Loc ui.etudes}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource StudyName}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                            <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id}"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <Button Content="{local:Loc ui.estimer_et_enregistrer}" Click="Calculate" Margin="12,0,0,0" Style="{StaticResource MkrPrimaryButton}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <RadioButton x:Name="PageResults" GroupName="IdentPage" IsChecked="True" Content="{local:Loc ui.resultats}" Style="{StaticResource MkrPageTab}" Checked="PageChanged" AutomationProperties.AutomationId="PageResults" ToolTip="{local:Loc ui.resultats_modele_parametres_qualite_comparaison}"/>
                    <RadioButton x:Name="PageSetup" GroupName="IdentPage" Content="{local:Loc ui.essais_et_actions}" Style="{StaticResource MkrPageTab}" Checked="PageChanged" AutomationProperties.AutomationId="PageSetup" ToolTip="{local:Loc ui.essais_d_estimation_et_de}"/>
                </StackPanel>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition x:Name="PanelColumn" Width="0.38*" MinWidth="300" MaxWidth="600"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="ChartArea">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="MainRow" Height="4*" MinHeight="140"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition x:Name="SideRow" Height="3*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource MkrSurfaceAlt}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" Padding="4,2" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MkrToolButton}" Click="FocusChart" ToolTip="{local:Loc ui.selection_glisser_avec_le_bouton}" AutomationProperties.Name="{local:Loc ui.selectionner_une_plage_ab}"><TextBlock Text="&#xE8B3;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                        <Button Style="{StaticResource MkrToolButton}" Click="ZoomIn" ToolTip="{local:Loc ui.zoom_avant_ou_molette}" AutomationProperties.Name="{local:Loc ui.zoom_avant}"><TextBlock Text="&#xE8A3;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                        <Button Style="{StaticResource MkrToolButton}" Click="ZoomOut" ToolTip="{local:Loc ui.zoom_arriere}" AutomationProperties.Name="{local:Loc ui.zoom_arriere}"><TextBlock Text="&#xE71F;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                        <Button Style="{StaticResource MkrToolButton}" Click="ResetPlotZoom" ToolTip="{local:Loc ui.ajuster_revenir_a_tout_lessai}" AutomationProperties.Name="{local:Loc ui.ajuster_a_tout_lessai}"><TextBlock Text="&#xE9A6;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                        <Button Style="{StaticResource MkrToolButton}" Click="ClearWindow" ToolTip="{local:Loc ui.effacer_la_plage_ab}" AutomationProperties.Name="{local:Loc ui.effacer_la_plage_ab}"><TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                        <Border Width="1" Background="{DynamicResource MkrBorder}" Margin="6,3"/>
                        <Label Content="{local:Loc ui.essai}" Target="{Binding ElementName=PlotSource}" VerticalAlignment="Center" Padding="2,0"/>
                        <ComboBox x:Name="PlotSource" Width="110" SelectedIndex="1" SelectionChanged="ChangePlotSource" VerticalAlignment="Center" MinHeight="24" Padding="6,1" AutomationProperties.Name="{local:Loc ui.essai_affiche}">
                            <ComboBoxItem Content="{local:Loc ui.estimation}"/>
                            <ComboBoxItem Content="{local:Loc ui.validation}"/>
                        </ComboBox>
                        <Border Width="1" Background="{DynamicResource MkrBorder}" Margin="6,3"/>
                        <Button Style="{StaticResource MkrToolButton}" Click="ExportPlotImage" ToolTip="{local:Loc ui.exporter_les_trois_graphiques_en}" AutomationProperties.Name="{local:Loc ui.exporter_limage}"><TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                        <Button Style="{StaticResource MkrToolButton}" Click="ExportPlotData" ToolTip="{local:Loc ui.exporter_les_courbes_affichees_en}" AutomationProperties.Name="{local:Loc ui.exporter_les_donnees}"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                        <Button Style="{StaticResource MkrToolButton}" Click="ToggleChartOnly" ToolTip="{local:Loc ui.donner_toute_la_largeur_aux}" AutomationProperties.Name="{local:Loc ui.plein_ecran_du_graphique}"><TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1">
                    <local:SignalChart x:Name="Chart" ReferenceStyle="True" ShowValueBoxes="False" SelectionEnabled="True" MinHeight="120"
                        AutomationProperties.Name="{local:Loc ui.reponse_du_procede_mesure_observee}"
                        AutomationProperties.HelpText="{local:Loc ui.glisser_pour_choisir_la_plage}"/>
                </Border>
                <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" AutomationProperties.Name="{local:Loc ui.redimensionner_les_graphiques}"/>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1">
                        <local:SignalChart x:Name="CommandChart" ReferenceStyle="True" ShowValueBoxes="False" SelectionEnabled="True" MinHeight="90"
                            AutomationProperties.Name="{local:Loc ui.commande_de_lessai_en_fonction}"/>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1">
                        <local:SignalChart x:Name="ResidualChart" ReferenceStyle="True" ShowValueBoxes="False" SelectionEnabled="True" MinHeight="90"
                            AutomationProperties.Name="{local:Loc ui.residus_mesure_moins_modele_en}"/>
                    </Border>
                </Grid>
                <Grid Grid.Row="4" Margin="2,3,0,0" MinHeight="18">
                    <TextBlock x:Name="PlotLegend" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MkrMuted}" FontSize="11"/>
                    <TextBlock x:Name="CursorText" Visibility="Collapsed" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11"/>
                </Grid>
            </Grid>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="{local:Loc ui.redimensionner_le_panneau}"/>
            <Grid x:Name="PanelScroll" Grid.Column="2">
                <ScrollViewer x:Name="ResultsPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <Expander x:Name="ModelPanel" Style="{StaticResource MkrPanel}" Header="{local:Loc ui.modele_identifie}">
                        <StackPanel Margin="10,4">
                            <StackPanel x:Name="FormulaHost" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2"/>
                            <TextBlock x:Name="FormulaFamily" Visibility="Collapsed"/>
                        </StackPanel>
                    </Expander>
                    <Expander Style="{StaticResource MkrPanel}" Header="{local:Loc ui.parametres_du_modele}">
                        <StackPanel x:Name="ParameterTable"/>
                    </Expander>
                    <Expander Style="{StaticResource MkrPanel}" Header="{local:Loc ui.qualite_du_modele}">
                        <StackPanel>
                            <StackPanel Margin="8,4,8,0">
                <Border x:Name="VerdictCard" Visibility="Collapsed" CornerRadius="3" Padding="5,2" Margin="0,0,0,2" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="VerdictBadge" CornerRadius="3" Padding="8,3" VerticalAlignment="Top" Margin="0,0,8,0">
                            <TextBlock x:Name="VerdictTitle" FontWeight="Bold" Foreground="{DynamicResource MkrOnStatus}"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="VerdictDetail" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11"/>
                            <WrapPanel x:Name="VerdictMetrics" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                                            </StackPanel>
                            <StackPanel x:Name="QualityTable"/>
                        </StackPanel>
                    </Expander>
                    <Expander Style="{StaticResource MkrPanel}" Header="{local:Loc ui.comparaison_des_modeles_memes_essais}">
                        <DataGrid x:Name="ModelTable" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="21" ColumnHeaderHeight="26" MaxHeight="150"
                                  SelectionMode="Single" SelectionChanged="ModelTableChanged" AutomationProperties.Name="{local:Loc ui.comparaison_des_modeles}">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="Padding" Value="6,2"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Height" Value="26"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{local:Loc ui.modele_2}" Binding="{Binding Family}" Width="1.2*"/>
                                <DataGridTextColumn Header="{local:Loc ui.fit}" Binding="{Binding Fit}" Width="*"/>
                                <DataGridTextColumn Header="RMSE" Binding="{Binding Rmse}" Width="*"/>
                                <DataGridTextColumn Header="{local:Loc ui.decision}" Binding="{Binding Decision}" Width="1.3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Expander>
                    <TextBlock x:Name="ModelNote" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MkrMuted}" Margin="4,3,4,6"/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="SetupPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <Expander x:Name="TrialsPanel" Style="{StaticResource MkrPanel}" Header="{local:Loc ui.essais_d_identification_estimation_et}">
                        <StackPanel x:Name="Form" Margin="10,8">
                    <GroupBox Header="{local:Loc ui.estimation}" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel Margin="6">
                            <Label Content="{local:Loc ui.import_2}" Target="{Binding ElementName=TrainingSource}" />
                            <ComboBox x:Name="TrainingSource" Width="200" DisplayMemberPath="Label" SelectionChanged="SelectTraining" >
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <Label Content="{local:Loc ui.temps}" Target="{Binding ElementName=TrainingTime}" />
                            <ComboBox x:Name="TrainingTime" Width="95" />
                            <Label Content="{local:Loc ui.sortie_de_commande}" Target="{Binding ElementName=TrainingMv}" />
                            <ComboBox x:Name="TrainingMv" Width="95" />
                            <Label Content="{local:Loc ui.mesure}" Target="{Binding ElementName=TrainingPv}" />
                            <ComboBox x:Name="TrainingPv" Width="95" />
                        </WrapPanel>
                        <Button Content="{local:Loc ui.afficher_les_courbes_brutes_estimation}"
                                Click="PreviewTraining" HorizontalAlignment="Left"
                                Margin="12,0,12,8"
                                ToolTip="{local:Loc ui.selectionner_une_plage_du_csv}"/>
                        <Button x:Name="FindTrials" Content="{local:Loc ui.rechercher_les_essais_exploitables_dans}"
                                Click="FindTrialsInRecording" HorizontalAlignment="Left" Margin="12,0,12,8"
                                ToolTip="{local:Loc ui.pour_un_historique_long_repere}"/>
                        <TextBlock x:Name="TrainingRangeInfo" Text="{local:Loc ui.estimation_fichier_complet}" Margin="12,0,8,8"
                                   Foreground="{DynamicResource MkrMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="{local:Loc ui.validation}" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel Margin="6">
                            <Label Content="{local:Loc ui.import_2}" Target="{Binding ElementName=ValidationSource}" />
                            <ComboBox x:Name="ValidationSource" Width="200" DisplayMemberPath="Label" SelectionChanged="SelectValidation" >
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <Label Content="{local:Loc ui.temps}" Target="{Binding ElementName=ValidationTime}" />
                            <ComboBox x:Name="ValidationTime" Width="95" />
                            <Label Content="{local:Loc ui.sortie_de_commande}" Target="{Binding ElementName=ValidationMv}" />
                            <ComboBox x:Name="ValidationMv" Width="95" />
                            <Label Content="{local:Loc ui.mesure}" Target="{Binding ElementName=ValidationPv}" />
                            <ComboBox x:Name="ValidationPv" Width="95" />
                        </WrapPanel>
                        <Button Content="{local:Loc ui.afficher_les_courbes_brutes_validation}"
                                Click="PreviewValidation" HorizontalAlignment="Left"
                                Margin="12,0,12,8"
                                ToolTip="{local:Loc ui.selectionner_une_plage_independante_pour}"/>
                        <TextBlock x:Name="ValidationRangeInfo" Text="{local:Loc ui.validation_fichier_complet}" Margin="12,0,8,8"
                                   Foreground="{DynamicResource MkrMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>
                    <WrapPanel Margin="0,0,0,8">
                        <Label Content="{local:Loc ui.unite_de_la_sortie_de}" Target="{Binding ElementName=MvUnit}" />
                        <TextBox x:Name="MvUnit" Width="65" MaxLength="40" />
                        <Label Content="{local:Loc ui.tolerance_de_la_sortie_de}" Target="{Binding ElementName=MvTolerance}" />
                        <TextBox x:Name="MvTolerance" Width="82" />
                        <Label Content="{local:Loc ui.unite_de_la_mesure}" Target="{Binding ElementName=PvUnit}" />
                        <TextBox x:Name="PvUnit" Width="65" MaxLength="40" />
                        <Label Content="{local:Loc ui.tolerance_de_la_mesure_avant}" Target="{Binding ElementName=PvTolerance}" />
                        <TextBox x:Name="PvTolerance" Width="82" />
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <Label Content="{local:Loc ui.erreur_quadratique_max_rmse_unite}" Target="{Binding ElementName=MaximumRmse}"/>
                        <TextBox x:Name="MaximumRmse" Width="76"/>
                        <Label Content="{local:Loc ui.correlation_residuelle_maximale_r1}" Target="{Binding ElementName=MaximumLag}"/>
                        <TextBox x:Name="MaximumLag" Width="76"/>
                        <Button x:Name="SuggestCriteria" Content="{local:Loc ui.proposer_les_criteres}" Click="ProposeCriteria" Margin="0,0,8,0"
                                ToolTip="{local:Loc ui.calcules_a_partir_du_bruit}"/>
                        <Button x:Name="CompareModels" Content="{local:Loc ui.comparer_fopdt_et_sopdt}" Click="Calculate"/>
                        <Button x:Name="ArxButton" Content="{local:Loc ui.identifier_par_arx_oe}" Click="IdentifyArx" Margin="8,0,0,0"
                                ToolTip="{local:Loc ui.excitation_quelconque_sans_regime_permanent}"/>
                        <Button x:Name="ArxTuneButton" Content="{local:Loc ui.reglage_guide_depuis_l_arx}" Click="TuneFromArx" Margin="8,0,0,0" IsEnabled="False"
                                ToolTip="{local:Loc ui.disponible_apres_une_etude_arx}"/>
                    </WrapPanel>
                    <CheckBox x:Name="Confirmed" Margin="0,2,0,8">
                        <TextBlock TextWrapping="Wrap" Text="{local:Loc ui.les_deux_essais_ont_ete}" />
                    </CheckBox>
                        </StackPanel>
                    </Expander>
                    <Expander Style="{StaticResource MkrPanel}" Header="{local:Loc ui.reglage_et_actions_sur_le}">
                        <StackPanel Margin="10,8">
                <Button x:Name="OpenLoopButton" Content="{local:Loc ui.simuler_en_boucle_ouverte}" Click="OpenLoop"
                        Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0" />
                <Button x:Name="ReviewButton" Content="{local:Loc ui.revue_de_l_etude}" Click="OpenReview"
                        Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0"
                        ToolTip="{local:Loc ui.calcule_verifie_approuve_decisions_attribuees}"/>
                <Button x:Name="DriftButton" Content="{local:Loc ui.verifier_le_modele_sur_un}" Click="CheckDrift"
                        Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0"
                        ToolTip="{local:Loc ui.choisissez_le_nouvel_echelon_en}"/>
                <Button x:Name="IntegratorButton" Content="{local:Loc ui.regler_le_procede_integrateur}" Click="OpenIntegrator"
                        Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0"
                        ToolTip="{local:Loc ui.pi_par_la_regle_simc}"/>
                <GroupBox x:Name="TargetPanel" Header="{local:Loc ui.comportement_souhaite}" Visibility="Collapsed" Margin="0,8,0,0">
                    <StackPanel Margin="8">
                        <WrapPanel>
                            <Label Content="{local:Loc ui.reponse}" Target="{Binding ElementName=ResponseProfile}"/>
                            <ComboBox x:Name="ResponseProfile" SelectionChanged="ChangeResponseProfile" Width="180">
                                <ComboBoxItem Content="{local:Loc ui.simc_reponse_rapide}"/>
                                <ComboBoxItem Content="{local:Loc ui.personnalisee}"/>
                            </ComboBox>
                            <Label Content="{local:Loc ui.cible_de_calcul_s}" Target="{Binding ElementName=ResponseTarget}"/>
                            <TextBox x:Name="ResponseTarget" TextChanged="ResponseTargetChanged" Width="100"/>
                        </WrapPanel>
                        <TextBlock x:Name="TargetHelp" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="SopdtPanel" Header="{local:Loc ui.reglage_pid_theorique_simc}" Visibility="Collapsed" Margin="0,8,0,0">
                    <StackPanel Margin="8">
                        <WrapPanel>
                            <Button x:Name="CalculatePidButton" IsEnabled="False" Content="{local:Loc ui.calculer_le_pid_simc}" Click="CalculateSopdt" Margin="8,0,0,0"/>
                        </WrapPanel>
                        <TextBlock x:Name="SopdtReport" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="PiPanel" Header="{local:Loc ui.reglages_pi_theoriques}" Visibility="Collapsed" Margin="0,8,0,0">
                    <StackPanel Margin="8">
                        <WrapPanel>
                            <Button x:Name="ComparePiButton" IsEnabled="False" Content="{local:Loc ui.comparer_lambda_et_simc}" Click="CalculatePi" Margin="8,0,0,0" />
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Label Content="{local:Loc ui.reglages_enregistres}" Target="{Binding ElementName=PiList}" />
                            <ComboBox x:Name="PiList" Width="245" DisplayMemberPath="Label" SelectionChanged="ShowPi" />
                            <Button x:Name="SimulateSavedPi" IsEnabled="False" Content="{local:Loc ui.simuler_le_reglage_enregistre}" Click="OpenSimulation" Margin="8,0,0,0" />
                            <Button x:Name="PidffValues" IsEnabled="False" Content="{local:Loc ui.valeurs_du_bloc_pidff}" Click="ShowPidffValues" Margin="8,0,0,0"
                                    ToolTip="{local:Loc ui.valeurs_documentaires_du_bloc_schneider}"/>
                            <Button x:Name="OtherBlocks" IsEnabled="False" Content="{local:Loc ui.blocs_pidint_et_pidcompact}" Click="ShowOtherBlocks" Margin="8,0,0,0"
                                    ToolTip="{local:Loc ui.valeurs_documentaires_des_blocs_schneider}"/>
                        </WrapPanel>
                        <TextBlock x:Name="PiReport" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </GroupBox>
                        </StackPanel>
                    </Expander>
                    <Expander Style="{StaticResource MkrPanel}" Header="{local:Loc ui.rapport_detaille_de_l_etude}">
                        <StackPanel Margin="10,8">
                            <TextBlock x:Name="FitReport" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        <TextBlock x:Name="Message" Grid.Row="2" Margin="2,4,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</UserControl>
