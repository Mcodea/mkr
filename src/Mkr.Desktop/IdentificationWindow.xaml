<Window x:Class="Mkr.Desktop.IdentificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MKR — Identification" Width="960" Height="780" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <TextBlock x:Name="Message" DockPanel.Dock="Bottom" Margin="0,12,0,0" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="Identification par échelons" />
                <TextBlock Margin="0,5,0,12" TextWrapping="Wrap"
                           Text="Deux essais distincts du même procédé, avec un seul échelon de MV par CSV. La validation utilise le deuxième essai." />
                <StackPanel x:Name="Form">
                    <GroupBox Header="Estimation" Margin="0,0,0,8">
                        <WrapPanel Margin="6">
                            <Label Content="Import" Target="{Binding ElementName=TrainingSource}" />
                            <ComboBox x:Name="TrainingSource" Width="200" DisplayMemberPath="Label" SelectionChanged="SelectTraining" />
                            <Label Content="Temps" Target="{Binding ElementName=TrainingTime}" />
                            <ComboBox x:Name="TrainingTime" Width="95" />
                            <Label Content="MV" Target="{Binding ElementName=TrainingMv}" />
                            <ComboBox x:Name="TrainingMv" Width="95" />
                            <Label Content="PV" Target="{Binding ElementName=TrainingPv}" />
                            <ComboBox x:Name="TrainingPv" Width="95" />
                        </WrapPanel>
                        <Button Content="Afficher les _courbes brutes MV/PV (estimation)…"
                                Click="PreviewTraining" HorizontalAlignment="Left"
                                Margin="12,0,12,8"
                                ToolTip="Sélectionner une plage du CSV original pour le prochain calcul"/>
                        <TextBlock x:Name="TrainingRangeInfo" Text="Estimation : fichier complet" Margin="12,0,8,8"
                                   Foreground="{StaticResource MkrMuted}" TextWrapping="Wrap"/>
                    </GroupBox>
                    <GroupBox Header="Validation" Margin="0,0,0,8">
                        <WrapPanel Margin="6">
                            <Label Content="Import" Target="{Binding ElementName=ValidationSource}" />
                            <ComboBox x:Name="ValidationSource" Width="200" DisplayMemberPath="Label" SelectionChanged="SelectValidation" />
                            <Label Content="Temps" Target="{Binding ElementName=ValidationTime}" />
                            <ComboBox x:Name="ValidationTime" Width="95" />
                            <Label Content="MV" Target="{Binding ElementName=ValidationMv}" />
                            <ComboBox x:Name="ValidationMv" Width="95" />
                            <Label Content="PV" Target="{Binding ElementName=ValidationPv}" />
                            <ComboBox x:Name="ValidationPv" Width="95" />
                        </WrapPanel>
                        <Button Content="Afficher les courbes brutes MV/PV (_validation)…"
                                Click="PreviewValidation" HorizontalAlignment="Left"
                                Margin="12,0,12,8"
                                ToolTip="Sélectionner une plage indépendante pour la validation"/>
                        <TextBlock x:Name="ValidationRangeInfo" Text="Validation : fichier complet" Margin="12,0,8,8"
                                   Foreground="{StaticResource MkrMuted}" TextWrapping="Wrap"/>
                    </GroupBox>
                    <WrapPanel Margin="0,0,0,8">
                        <Label Content="Unité MV" Target="{Binding ElementName=MvUnit}" />
                        <TextBox x:Name="MvUnit" Width="65" MaxLength="40" />
                        <Label Content="Tolérance des plateaux MV" Target="{Binding ElementName=MvTolerance}" />
                        <TextBox x:Name="MvTolerance" Width="82" />
                        <Label Content="Unité PV" Target="{Binding ElementName=PvUnit}" />
                        <TextBox x:Name="PvUnit" Width="65" MaxLength="40" />
                        <Label Content="Tolérance PV avant échelon" Target="{Binding ElementName=PvTolerance}" />
                        <TextBox x:Name="PvTolerance" Width="82" />
                    </WrapPanel>
                    <CheckBox x:Name="Confirmed" Margin="0,2,0,8">
                        <TextBlock TextWrapping="Wrap" Text="Les deux essais ont été réalisés en boucle ouverte, sans saturation connue, avec les mêmes unités et dans des conditions comparables." />
                    </CheckBox>
                    <WrapPanel Margin="0,0,0,10">
                        <Label Content="Famille" Target="{Binding ElementName=FamilyChoice}" />
                        <ComboBox x:Name="FamilyChoice" Width="95" Margin="0,0,8,0" />
                        <Button Content="_Estimer et enregistrer" Click="Calculate" />
                        <Label Content="Études" Target="{Binding ElementName=StudyList}" Margin="10,0,0,0" />
                        <ComboBox x:Name="StudyList" Width="260" DisplayMemberPath="Label" SelectionChanged="ShowStudy" />
                    </WrapPanel>
                </StackPanel>
                <TextBlock x:Name="FitReport" TextWrapping="Wrap" />
                <Border Background="{StaticResource MkrSurface}" BorderBrush="{StaticResource MkrBorder}"
                        BorderThickness="1" Padding="14" CornerRadius="6" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Diagnostic du modèle" FontWeight="SemiBold" FontSize="17"
                                   Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Label Content="_Essai affiché" Target="{Binding ElementName=PlotSource}"
                                   VerticalAlignment="Center"/>
                            <ComboBox x:Name="PlotSource" Width="160" SelectedIndex="1"
                                      SelectionChanged="ChangePlotSource" VerticalAlignment="Center">
                                <ComboBoxItem Content="Estimation"/>
                                <ComboBoxItem Content="Validation"/>
                            </ComboBox>
                            <Button Content="_Réinitialiser le zoom" Click="ResetPlotZoom"
                                    Margin="12,0,0,0"
                                    ToolTip="Revenir à l’horizon complet de l’essai affiché"/>
                        </WrapPanel>
                        <TextBlock x:Name="PlotLegend" Margin="0,2,0,8" TextWrapping="Wrap"
                                   Foreground="{StaticResource MkrMuted}"/>
                        <Canvas x:Name="Plot" Height="390" ClipToBounds="True" SizeChanged="ResizePlot"
                                Background="{StaticResource MkrSurface}"
                                MouseLeftButtonDown="PlotStartSelection"
                                MouseLeftButtonUp="PlotEndSelection"
                                MouseLeave="PlotCancelSelection"
                                AutomationProperties.Name="PV mesurée, PV prédite et résidus de l’essai sélectionné"/>
                        <TextBlock Text="Pour zoomer, faites glisser horizontalement sur le graphique. Le zoom modifie seulement l’affichage, jamais les données ou les paramètres de l’étude."
                                   Foreground="{StaticResource MkrMuted}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Button x:Name="OpenLoopButton" Content="_Simuler en boucle ouverte…" Click="OpenLoop"
                        Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0" />
                <GroupBox x:Name="PiPanel" Header="Réglages PI théoriques" Visibility="Collapsed" Margin="0,8,0,0">
                    <StackPanel Margin="8">
                        <WrapPanel>
                            <Label Content="_Temps de réponse choisi (s)" Target="{Binding ElementName=PiResponse}" />
                            <TextBox x:Name="PiResponse" Width="80" />
                            <Button Content="_Comparer IMC/Lambda et SIMC" Click="CalculatePi" Margin="8,0,0,0" />
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Label Content="Réglages enregistrés" Target="{Binding ElementName=PiList}" />
                            <ComboBox x:Name="PiList" Width="245" DisplayMemberPath="Label" SelectionChanged="ShowPi" />
                            <Button Content="Simuler en boucle _fermée…" Click="OpenSimulation" Margin="8,0,0,0" />
                        </WrapPanel>
                        <TextBlock x:Name="PiReport" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
