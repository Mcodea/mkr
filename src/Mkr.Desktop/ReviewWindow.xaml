<Window x:Class="Mkr.Desktop.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MKR — Revue de l'étude" Width="900" Height="720" MinWidth="620" MinHeight="480" WindowStartupLocation="CenterOwner">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource MkrAccentPale}" BorderBrush="{StaticResource MkrBorder}" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap"
                       Text="Règle des quatre yeux : celui qui a calculé une étape ne la vérifie ni ne l'approuve, sauf auto-revue déclarée, inscrite comme telle. L'auteur de chaque décision est l'identité de la session Windows (compte, SID, poste) : il ne se saisit pas."/>
        </Border>
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="Identity" TextWrapping="Wrap" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,8,0,0">
                <Label Content="É_tape" Target="{Binding ElementName=Stage}"/>
                <ComboBox x:Name="Stage" Width="150" SelectionChanged="StageChanged" AutomationProperties.Name="Étape de la revue"/>
            </WrapPanel>
            <TextBlock x:Name="StateLine" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <WrapPanel Margin="0,8,0,0">
                <Label Content="_Motif" Target="{Binding ElementName=Reason}"/>
                <TextBox x:Name="Reason" Width="320" MaxLength="500" AutomationProperties.Name="Motif de la décision"/>
                <Label Content="_Référence de preuve" Target="{Binding ElementName=Evidence}" Margin="12,0,0,0"/>
                <TextBox x:Name="Evidence" Width="220" MaxLength="500" AutomationProperties.Name="Référence de la preuve"/>
            </WrapPanel>
            <CheckBox x:Name="SelfReview" Margin="0,8,0,0" AutomationProperties.Name="Auto-revue déclarée">
                <TextBlock Text="Je déclare vérifier ou approuver mon propre calcul (auto-revue, inscrite comme telle)"/>
            </CheckBox>
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="Calculated" Content="Marquer comme _calculé" Click="Record"/>
                <Button x:Name="Verify" Content="_Vérifier" Click="Record" Margin="8,0,0,0"/>
                <Button x:Name="Approve" Content="_Approuver" Click="Record" Margin="8,0,0,0"/>
                <Button x:Name="Reject" Content="_Rejeter" Click="Record" Margin="8,0,0,0"/>
            </WrapPanel>
            <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <TextBox x:Name="History" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,12,0,0"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="Historique de la revue"/>
        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="_Fermer" IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>
