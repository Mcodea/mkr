<Window x:Class="Mkr.Desktop.IntegratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mkr.Desktop"
        Title="{local:Loc ui.orias_reglage_d_un_procede}"
        Width="820" Height="700" MinWidth="560" MinHeight="460" WindowStartupLocation="CenterOwner">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource MkrAccentPale}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap"
                       Text="{local:Loc ui.regle_simc_des_procedes_integrateurs}"/>
        </Border>
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="ModelLine" TextWrapping="Wrap" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,8,0,0">
                <Label Content="{local:Loc ui.duree_de_reponse_souhaitee_c}" Target="{Binding ElementName=ResponseSeconds}"/>
                <TextBox x:Name="ResponseSeconds" Width="100" AutomationProperties.Name="{local:Loc ui.duree_de_reponse_en_secondes}" TextChanged="InputChanged"/>
                <Button x:Name="Compute" Content="{local:Loc ui.calculer}" IsEnabled="False" Click="Calculate" Margin="8,0,0,0"/>
                <Button x:Name="BlockValues" Content="{local:Loc ui.valeurs_du_bloc_pidff}" IsEnabled="False" Click="ShowBlock" Margin="8,0,0,0"/>
            </WrapPanel>
            <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <TextBox x:Name="Result" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,12,0,0"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="{local:Loc ui.reglage_de_l_integrateur}"/>
        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="{local:Loc ui.fermer}" IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>
