<Window x:Class="Mkr.Desktop.CsvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="960" Height="740" MinWidth="640" MinHeight="590" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="_Données CSV">
                <DockPanel Margin="12">
                    <StackPanel x:Name="Controls" DockPanel.Dock="Top">
                        <WrapPanel Margin="0,0,0,8">
                            <Label Content="_Séparateur" Target="{Binding ElementName=Delimiter}" />
                            <ComboBox x:Name="Delimiter" Width="122" SelectedIndex="0" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Virgule" Tag="," />
                                <ComboBoxItem Content="Point-virgule" Tag=";" />
                            </ComboBox>
                            <Button Content="_Choisir un CSV…" Click="ChooseCsv" Margin="8,0,0,0" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <Label Content="_Horodatage" Target="{Binding ElementName=TimeColumn}" />
                            <ComboBox x:Name="TimeColumn" Width="130" />
                            <Label Content="_Valeur" Target="{Binding ElementName=ValueColumn}" />
                            <ComboBox x:Name="ValueColumn" Width="130" />
                            <Label Content="_Rôle" Target="{Binding ElementName=Role}" />
                            <ComboBox x:Name="Role" Width="60" />
                            <Label Content="_Unité" Target="{Binding ElementName=Unit}" />
                            <TextBox x:Name="Unit" Width="100" MaxLength="40" />
                            <Button x:Name="Analyze" Content="_Analyser et enregistrer" Click="AnalyzeCsv" IsEnabled="False" Margin="8,0,0,0" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <Label Content="_Imports enregistrés" Target="{Binding ElementName=Imports}" />
                            <ComboBox x:Name="Imports" Width="280" DisplayMemberPath="Label" />
                            <Button Content="_Ouvrir" Click="OpenImport" Margin="8,0,0,0" />
                            <Button Content="Exporter l’_original…" Click="ExportOriginal" Margin="8,0,0,0" />
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock x:Name="Report" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <DataGrid x:Name="Preview" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              AutomationProperties.Name="Aperçu des données CSV" />
                </DockPanel>
            </TabItem>
            <TabItem Header="_Procédé">
                <DockPanel Margin="12">
                    <Label DockPanel.Dock="Top" Content="_Description du procédé" Target="{Binding ElementName=Description}" />
                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Content="_Enregistrer la description"
                            Click="SaveDescription" Margin="0,8,0,0" />
                    <TextBox x:Name="Description" AcceptsReturn="True" MaxLength="4000" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="_Identification FOPDT…" Click="OpenFopdt" Margin="12,0,0,0" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
    </Grid>
</Window>
