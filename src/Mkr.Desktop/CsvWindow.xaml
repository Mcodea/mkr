<Window x:Class="Mkr.Desktop.CsvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1160" Height="820" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="MKR  /  PROJET  /  DONNÉES"
                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MkrAccent}"/>
                <TextBlock Text="Préparation des données" FontSize="27" FontWeight="SemiBold"
                           Margin="0,7,0,3"/>
                <TextBlock Text="Importez, qualifiez et conservez les historiques du procédé."
                           Foreground="{StaticResource MkrMuted}" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="1" Padding="12,7" Margin="12,0,0,0"
                    BorderBrush="{StaticResource MkrBorder}" BorderThickness="1"
                    Background="{StaticResource MkrSurface}" CornerRadius="5"
                    VerticalAlignment="Top">
                <TextBlock Text="Acquisition hors ligne · CSV" Foreground="{StaticResource MkrMuted}"
                           FontSize="11"/>
            </Border>
        </Grid>
        <TabControl Grid.Row="1" Background="{StaticResource MkrSurface}"
                    BorderBrush="{StaticResource MkrBorder}" Padding="2">
            <TabItem Header="_Données CSV">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" MaxHeight="310">
                        <StackPanel x:Name="Controls">
                            <Border BorderBrush="{StaticResource MkrBorder}" BorderThickness="1"
                                    Background="{StaticResource MkrCanvas}" CornerRadius="6"
                                    Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="01  ·  Source et format du fichier" FontSize="15"
                                               FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Label Content="_Séparateur" Target="{Binding ElementName=Delimiter}"
                                               VerticalAlignment="Center"/>
                                        <ComboBox x:Name="Delimiter" Width="145" SelectedIndex="0"
                                                  SelectedValuePath="Tag" VerticalAlignment="Center">
                                            <ComboBoxItem Content="Virgule" Tag=","/>
                                            <ComboBoxItem Content="Point-virgule" Tag=";"/>
                                        </ComboBox>
                                        <Button Content="_Choisir un CSV…" Click="ChooseCsv"
                                                Margin="12,0,0,0" ToolTip="Importer un fichier CSV en UTF-8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{StaticResource MkrBorder}" BorderThickness="1"
                                    Background="{StaticResource MkrSurface}" CornerRadius="6"
                                    Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="02  ·  Correspondance des variables"
                                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBlock Text="Sélectionnez explicitement les colonnes, le rôle métier et l’unité physique. Aucun rôle n’est déduit automatiquement."
                                               Foreground="{StaticResource MkrMuted}"
                                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,12,8">
                                            <Label Content="_Horodatage" Target="{Binding ElementName=TimeColumn}"
                                                   Padding="0" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="TimeColumn" Width="185" MinHeight="34"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,8">
                                            <Label Content="_Valeur" Target="{Binding ElementName=ValueColumn}"
                                                   Padding="0" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="ValueColumn" Width="185" MinHeight="34"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,8">
                                            <Label Content="_Rôle" Target="{Binding ElementName=Role}"
                                                   Padding="0" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="Role" Width="92" MinHeight="34"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,8">
                                            <Label Content="_Unité" Target="{Binding ElementName=Unit}"
                                                   Padding="0" Margin="0,0,0,4"/>
                                            <TextBox x:Name="Unit" Width="112" MaxLength="40"/>
                                        </StackPanel>
                                        <Button x:Name="Analyze" Content="_Analyser et enregistrer"
                                                Click="AnalyzeCsv" IsEnabled="False" VerticalAlignment="Bottom"
                                                Margin="0,0,0,8" Style="{StaticResource MkrPrimaryButton}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{StaticResource MkrBorder}" BorderThickness="1"
                                    Background="{StaticResource MkrSurface}" CornerRadius="6"
                                    Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="03  ·  Imports enregistrés" FontSize="15"
                                               FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Label Content="_Imports enregistrés"
                                               Target="{Binding ElementName=Imports}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="Imports" Width="280" MinHeight="34"
                                                  DisplayMemberPath="Label" VerticalAlignment="Center"/>
                                        <Button Content="_Ouvrir" Click="OpenImport" Margin="10,0,0,0"/>
                                        <Button Content="Exporter l’_original…" Click="ExportOriginal"
                                                Margin="8,0,0,0"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" BorderBrush="{StaticResource MkrBorder}" BorderThickness="1"
                            CornerRadius="6" Background="{StaticResource MkrSurface}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Aperçu du fichier" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="Lignes source affichées sans modification des valeurs brutes."
                                           Foreground="{StaticResource MkrMuted}" Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <DataGrid Grid.Row="1" x:Name="Preview" IsReadOnly="True"
                                      CanUserAddRows="False" AutoGenerateColumns="False"
                                      AutomationProperties.Name="Aperçu des données CSV"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="12"
                            BorderBrush="{StaticResource MkrBorder}" BorderThickness="1"
                            Background="{StaticResource MkrAccentPale}" CornerRadius="6"
                            MaxHeight="130">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Qualité et provenance" FontSize="13"
                                           FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBlock x:Name="Report" TextWrapping="Wrap"
                                           Foreground="{StaticResource MkrText}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="_Procédé">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Description du procédé"
                               FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBox Grid.Row="1" x:Name="Description" AcceptsReturn="True"
                             MaxLength="4000" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Description du procédé"/>
                    <Button Grid.Row="2" Content="_Enregistrer la description"
                            Click="SaveDescription" HorizontalAlignment="Left"
                            Margin="0,12,0,0" Style="{StaticResource MkrPrimaryButton}"/>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" BorderBrush="{StaticResource MkrBorder}"
                BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource MkrMuted}"
                           AutomationProperties.LiveSetting="Polite"/>
                <Button Grid.Column="1" Content="_Identification…" Click="OpenIdentification"
                        Style="{StaticResource MkrPrimaryButton}"
                        ToolTip="Ouvrir les études d’identification du projet"/>
            </Grid>
        </Border>
    </Grid>
</Window>