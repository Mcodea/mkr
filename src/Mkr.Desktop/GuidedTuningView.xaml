<UserControl x:Class="Mkr.Desktop.GuidedTuningView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mkr.Desktop">
    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource MkrSurfaceAlt}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" Padding="10,6">
            <Border.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="10,2"/></Style>
<Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6,2"/></Style>
<Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6,2"/></Style></Border.Resources>
            <StackPanel>
                <TextBlock x:Name="ModelLine" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <WrapPanel>
                    <Label Content="{local:Loc ui.objectif}" Target="{Binding ElementName=Objective}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="Objective" Width="300" SelectedIndex="1" SelectionChanged="ObjectiveChanged" AutomationProperties.Name="{local:Loc ui.objectif_de_robustesse}" VerticalAlignment="Center">
                        <ComboBoxItem Tag="robust" Content="{local:Loc ui.robuste_ms_1_4_marge}"/>
                        <ComboBoxItem Tag="balanced" Content="{local:Loc ui.equilibre_ms_1_7}"/>
                        <ComboBoxItem Tag="performance" Content="{local:Loc ui.performance_ms_2_0_plus}"/>
                    </ComboBox>
                    <Label Content="{local:Loc ui.variation_du_procede}" Target="{Binding ElementName=Variation}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox x:Name="Variation" Width="60" VerticalAlignment="Center" AutomationProperties.Name="{local:Loc ui.variation_attendue_du_procede_en}"
                             ToolTip="{local:Loc ui.facultatif_ecart_attendu_du_gain}"/>
                    <Button x:Name="Compute" Content="{local:Loc ui.calculer_le_reglage_guide}" Click="Calculate" Margin="14,0,0,0" Style="{StaticResource MkrPrimaryButton}" VerticalAlignment="Center"/>
                    <Button x:Name="CopyButton" Content="{local:Loc ui.copier_le_resultat}" IsEnabled="False" Click="Copy" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <Button x:Name="CloseButton" Content="{local:Loc ui.fermer}" Click="CloseView" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </WrapPanel>
                <TextBlock x:Name="ObjectiveHelp" TextWrapping="Wrap" Foreground="{DynamicResource MkrMuted}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="0,6,0,0">
            <Border x:Name="Verdict" Visibility="Collapsed" Padding="12,6" Margin="0,0,0,4">
                <TextBlock x:Name="VerdictText" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MkrOnStatus}"/>
            </Border>
            <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="360" MinWidth="260" MaxWidth="640"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="CurveBar" Background="{DynamicResource MkrSurfaceAlt}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" Padding="6,2" Margin="0,0,0,4" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MkrToolButton}" Click="ZoomIn" ToolTip="{local:Loc ui.zoom_avant_ou_molette}" AutomationProperties.Name="{local:Loc ui.zoom_avant}"><TextBlock Text="&#xE8A3;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                        <Button Style="{StaticResource MkrToolButton}" Click="ZoomOut" ToolTip="{local:Loc ui.zoom_arriere}" AutomationProperties.Name="{local:Loc ui.zoom_arriere}"><TextBlock Text="&#xE71F;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                        <Button Style="{StaticResource MkrToolButton}" Click="ResetView" ToolTip="{local:Loc ui.revenir_a_toute_la_reponse}" AutomationProperties.Name="{local:Loc ui.ajuster_a_toute_la_reponse}"><TextBlock Text="&#xE9A6;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                        <Button Style="{StaticResource MkrToolButton}" Click="ExportImage" ToolTip="{local:Loc ui.exporter_les_graphiques_en_image}" AutomationProperties.Name="{local:Loc ui.exporter_limage}"><TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                        <Button Style="{StaticResource MkrToolButton}" Click="ExportData" ToolTip="{local:Loc ui.exporter_les_courbes_en_csv}" AutomationProperties.Name="{local:Loc ui.exporter_les_donnees}"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                        <Border Width="1" Background="{DynamicResource MkrBorder}" Margin="8,3"/>
                        <TextBlock Text="{local:Loc ui.courbes}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton x:Name="ShowSetpoint" Content="{local:Loc ui.echelon_de_consigne}" GroupName="Curve" IsChecked="True" Checked="CurveChanged" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="ShowLoad" Content="{local:Loc ui.perturbation_de_charge}" GroupName="Curve" Checked="CurveChanged" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <local:SignalChart x:Name="Chart" Grid.Row="1" Visibility="Collapsed" MinHeight="260" ReferenceStyle="True" ShowValueBoxes="False"
                                   AutomationProperties.Name="{local:Loc ui.reponses_simulees_des_reglages_compares}"/>
                <TextBlock x:Name="CursorLine" Grid.Row="2" FontSize="11" TextTrimming="CharacterEllipsis" Margin="2,3,0,0" Foreground="{DynamicResource MkrMuted}"/>
                <TextBlock x:Name="ChartEmpty" Grid.Row="1" Text="{local:Loc ui.les_reponses_simulees_des_reglages}" Foreground="{DynamicResource MkrMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="{local:Loc ui.redimensionner_le_panneau}"/>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Expander x:Name="ParamPanel" Style="{StaticResource MkrPanel}" Header="{local:Loc ui.reglage_recommande}" Visibility="Collapsed">
                        <StackPanel x:Name="Cards"/>
                    </Expander>
                    <Expander x:Name="ComparePanel" Style="{StaticResource MkrPanel}" Header="{local:Loc ui.comparaison_des_reglages_nominal_echelon}" Visibility="Collapsed">
                        <Grid x:Name="CompareGrid" Margin="0"/>
                    </Expander>
                    <Expander x:Name="AltPanel" Style="{StaticResource MkrPanel}" Header="{local:Loc ui.reglages_voisins_vitesse_contre_robustesse}" Visibility="Collapsed" IsExpanded="False">
                        <DataGrid x:Name="Alternatives" RowHeight="30" ColumnHeaderHeight="40" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False"
                                  AutomationProperties.Name="{local:Loc ui.reglages_voisins}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="τc (s)" Binding="{Binding Response}" Width="*"/>
                                <DataGridTextColumn Header="Kp" Binding="{Binding Kp}" Width="*"/>
                                <DataGridTextColumn Header="{local:Loc ui.ti_s}" Binding="{Binding Ti}" Width="*"/>
                                <DataGridTextColumn Header="{local:Loc ui.td_s}" Binding="{Binding Td}" Width="*"/>
                                <DataGridTextColumn Header="{local:Loc ui.ms_pire_cas}" Binding="{Binding Ms}" Width="*"/>
                                <DataGridTextColumn Header="{local:Loc ui.verdict}" Binding="{Binding Verdict}" Width="1.6*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Expander>
                    <Expander Style="{StaticResource MkrPanel}" Header="{local:Loc ui.notes_et_reserves}">
                        <StackPanel Margin="10,8">
                            <TextBlock x:Name="Notes" TextWrapping="Wrap" Foreground="{DynamicResource MkrMuted}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="Normal"
                                       Text="{local:Loc ui.vous_choisissez_un_objectif_de}"/>
                        </StackPanel>
                    </Expander>
                    <TextBox x:Name="Result" IsReadOnly="True" Visibility="Collapsed" AutomationProperties.Name="{local:Loc ui.resultat_du_reglage_guide_texte}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
