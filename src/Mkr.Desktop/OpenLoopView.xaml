<UserControl x:Class="Mkr.Desktop.OpenLoopView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mkr.Desktop">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18">
            <TextBlock x:Name="Units" TextWrapping="Wrap" Margin="0,0,0,10" />
            <StackPanel x:Name="ScenarioForm">
                <WrapPanel Margin="0,0,0,6">
                    <Label Content="{local:Loc ui.pas_s}" Target="{Binding ElementName=Sample}" />
                    <TextBox x:Name="Sample" Width="75" />
                    <Label Content="{local:Loc ui.duree_s}" Target="{Binding ElementName=Duration}" />
                    <TextBox x:Name="Duration" Width="75" />
                    <Label Content="{local:Loc ui.instant_de_lechelon_s}" Target="{Binding ElementName=StepAt}" />
                    <TextBox x:Name="StepAt" Width="75" Text="0" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,6">
                    <Label Content="{local:Loc ui.echelon_de_sortie}" Target="{Binding ElementName=StepMv}" />
                    <TextBox x:Name="StepMv" Width="75" />
                    <Label Content="{local:Loc ui.sortie_min_ecart}" Target="{Binding ElementName=Lower}" />
                    <TextBox x:Name="Lower" Width="75" />
                    <Label Content="{local:Loc ui.sortie_max_ecart}" Target="{Binding ElementName=Upper}" />
                    <TextBox x:Name="Upper" Width="75" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,6">
                    <Label x:Name="RateLabel" Target="{Binding ElementName=Rate}" />
                    <TextBox x:Name="Rate" Width="90" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,8">
                    <Button Content="{local:Loc ui.simuler}" Click="Run" />
                    <Button x:Name="ExportButton" Content="{local:Loc ui.exporter_les_series}" Click="Export"
                            IsEnabled="False" Margin="8,0,0,0" />
                </WrapPanel>
            </StackPanel>
            <TextBlock x:Name="Message" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="Report" TextWrapping="Wrap" Margin="0,8,0,0" />
            <local:SignalChart x:Name="Chart" Height="360" Margin="0,8,0,0"
                    AutomationProperties.Name="{local:Loc ui.reponse_de_la_mesure_en}"
                    AutomationProperties.HelpText="{local:Loc ui.molette_zoom_clic_droit_glisse_2}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
