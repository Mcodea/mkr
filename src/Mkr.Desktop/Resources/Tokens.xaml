<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- MKR design system · typography and spacing tokens (theme independent). -->
    <FontFamily x:Key="MkrFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MkrMono">Cascadia Mono, Consolas</FontFamily>
    <x:Double x:Key="MkrFontCaption">11</x:Double>
    <x:Double x:Key="MkrFontBody">13</x:Double>
    <x:Double x:Key="MkrFontSubtitle">15</x:Double>
    <x:Double x:Key="MkrFontTitle">20</x:Double>
    <x:Double x:Key="MkrFontDisplay">27</x:Double>
    <!-- 4 px grid: use these instead of ad-hoc margins in new XAML. -->
    <Thickness x:Key="MkrSpace1">4</Thickness>
    <Thickness x:Key="MkrSpace2">8</Thickness>
    <Thickness x:Key="MkrSpace3">12</Thickness>
    <Thickness x:Key="MkrSpace4">16</Thickness>
    <Thickness x:Key="MkrSpace6">24</Thickness>
    <CornerRadius x:Key="MkrRadius">6</CornerRadius>
    <CornerRadius x:Key="MkrRadiusLarge">8</CornerRadius>

    <Style x:Key="MkrCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MkrFontCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource MkrMuted}"/>
    </Style>
    <Style x:Key="MkrSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MkrFontSubtitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="MkrTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MkrFontTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="MkrDisplay" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MkrFontDisplay}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
</ResourceDictionary>
