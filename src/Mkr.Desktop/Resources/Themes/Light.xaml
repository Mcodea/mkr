<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- MKR design system · colour tokens · thème clair. Semantic names only: windows never use a literal colour.
         Every text/background pair is checked against WCAG 2.1 AA (4.5:1) by tests/test_theme_contrast.py. -->
    <SolidColorBrush x:Key="MkrNavy" Color="#1F4A7A"/>
    <SolidColorBrush x:Key="MkrBrand" Color="#0F2F55"/>
    <SolidColorBrush x:Key="MkrTitleBar" Color="#DCE5F0"/>
    <SolidColorBrush x:Key="MkrNavySoft" Color="#2B5C94"/>
    <SolidColorBrush x:Key="MkrNavyText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MkrNavyMuted" Color="#C3D3E6"/>
    <SolidColorBrush x:Key="MkrCanvas" Color="#EEF1F5"/>
    <SolidColorBrush x:Key="MkrSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MkrSurfaceAlt" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="MkrBorder" Color="#D3DAE3"/>
    <SolidColorBrush x:Key="MkrBorderStrong" Color="#76859A"/>
    <SolidColorBrush x:Key="MkrText" Color="#17212F"/>
    <SolidColorBrush x:Key="MkrMuted" Color="#4E5F73"/>
    <SolidColorBrush x:Key="MkrAccent" Color="#1B5599"/>
    <SolidColorBrush x:Key="MkrAccentPale" Color="#E4EDF8"/>
    <SolidColorBrush x:Key="MkrOnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MkrSuccess" Color="#1B7F4B"/>
    <SolidColorBrush x:Key="MkrSuccessPale" Color="#E8F5EE"/>
    <SolidColorBrush x:Key="MkrDanger" Color="#B3261E"/>
    <SolidColorBrush x:Key="MkrDangerPale" Color="#FCECEA"/>
    <SolidColorBrush x:Key="MkrWarning" Color="#8A5A00"/>
    <SolidColorBrush x:Key="MkrWarningPale" Color="#FFF3D6"/>
    <SolidColorBrush x:Key="MkrOnStatus" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MkrPlotAxis" Color="#7A8797"/>
    <SolidColorBrush x:Key="MkrPlotLabel" Color="#4E5F73"/>
    <SolidColorBrush x:Key="MkrPlotGrid" Color="#E1E7EE"/>
    <SolidColorBrush x:Key="MkrSignal1" Color="#1F6FB5"/>
    <SolidColorBrush x:Key="MkrSignal2" Color="#C25E00"/>
    <SolidColorBrush x:Key="MkrSignal3" Color="#1B7F4B"/>
    <SolidColorBrush x:Key="MkrSignal4" Color="#A12B6E"/>
    <!-- ORIAS logo for this theme (transparent PNG; the dark variant has a light wordmark). -->
    <BitmapImage x:Key="OriasLogo" UriSource="pack://application:,,,/Assets/orias-logo.png" CacheOption="OnLoad"/>
    <BitmapImage x:Key="OriasSymbol" UriSource="pack://application:,,,/Assets/orias-symbol.png" CacheOption="OnLoad"/>
</ResourceDictionary>
