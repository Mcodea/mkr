<Window x:Class="Mkr.Desktop.HelpWindow" Title="{local:Loc ui.orias_aide}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mkr.Desktop"
        Width="640" Height="560" MinWidth="420" MinHeight="360" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="22,18,22,16">
        <Button DockPanel.Dock="Bottom" Content="{local:Loc ui.fermer}" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Margin="0,14,0,0" Click="CloseHelp"
                AutomationProperties.Name="{local:Loc ui.fermer_l_aide}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{local:Loc ui.aide_orias}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock Text="{local:Loc ui.parcours_d_etude}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Text="{local:Loc help.path}"/>
                <TextBlock Text="{local:Loc ui.vocabulaire}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Text="{local:Loc help.vocabulary}"/>
                <TextBlock Text="{local:Loc ui.securite_et_limites}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Text="{local:Loc help.safety}"/>
                <TextBlock Text="{local:Loc ui.raccourcis}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" Text="{local:Loc help.shortcuts}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
