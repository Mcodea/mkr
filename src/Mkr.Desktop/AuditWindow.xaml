<Window x:Class="Mkr.Desktop.AuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MKR — Journal d'audit" Width="980" Height="700" MinWidth="620" MinHeight="420" WindowStartupLocation="CenterOwner">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource MkrAccentPale}" BorderBrush="{StaticResource MkrBorder}" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap"
                       Text="Journal en ajout seul, chaîné par empreintes SHA-256 : une entrée modifiée ou retirée au milieu rompt la chaîne. Il ne protège pas d'une réécriture complète par quelqu'un qui peut tout écrire dans le fichier du projet : notez l'empreinte de tête ailleurs pour le détecter."/>
        </Border>
        <TextBox x:Name="Entries" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                 AutomationProperties.Name="Entrées du journal"/>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <WrapPanel>
                <Button Content="_Vérifier l'intégrité" Click="Verify"/>
                <Button Content="_Fermer" IsCancel="True" Margin="8,0,0,0"/>
            </WrapPanel>
            <TextBlock x:Name="VerifyStatus" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </Grid>
</Window>
