<Window x:Class="Mkr.Desktop.StartupWindow" Title="{local:Loc ui.orias_demarrage}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mkr.Desktop"
        AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource Self}}"
        Width="520" Height="300" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="{DynamicResource MkrSurface}">
    <Border BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" Padding="34,30,34,22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Image Source="{DynamicResource OriasLogo}" Height="62" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="ORIAS"/>
            <TextBlock Grid.Row="1" x:Name="Tagline" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource MkrAccent}" Margin="0,14,0,0"/>
            <TextBlock Grid.Row="3" x:Name="Status" Foreground="{DynamicResource MkrText}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
            <ProgressBar Grid.Row="4" IsIndeterminate="True" Height="4" AutomationProperties.Name="{local:Loc ui.initialisation_en_cours}"/>
            <TextBlock Grid.Row="2" x:Name="VersionLine" Foreground="{DynamicResource MkrMuted}" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
        </Grid>
    </Border>
</Window>
