<UserControl x:Class="Mkr.Desktop.BlockTargetView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mkr.Desktop">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource MkrAccentPale}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                       Text="{local:Loc ui.valeurs_documentaires_non_qualifiees_pour}"/>
        </Border>
        <StackPanel Grid.Row="1">
            <WrapPanel>
                <Label Content="{local:Loc ui.bloc}" Target="{Binding ElementName=BlockChoice}"/>
                <ComboBox x:Name="BlockChoice" Width="150" SelectionChanged="BlockChanged" AutomationProperties.Name="{local:Loc ui.bloc_cible}">
                    <ComboBoxItem Content="PID_INT" Tag="PID_INT"/>
                    <ComboBoxItem Content="{local:Loc ui.pidcompact}" Tag="PID_Compact"/>
                </ComboBox>
            </WrapPanel>
            <WrapPanel x:Name="IntPanel" Margin="0,8,0,0" Visibility="Collapsed">
                <Label Content="{local:Loc ui.etendue_de_la_mesure}" Target="{Binding ElementName=PvSpan}"/>
                <TextBox x:Name="PvSpan" Width="90" AutomationProperties.Name="{local:Loc ui.etendue_de_la_mesure_2}"/>
                <Label Content="{local:Loc ui.etendue_de_la_sortie_de}" Target="{Binding ElementName=MvSpan}" Margin="12,0,0,0"/>
                <TextBox x:Name="MvSpan" Width="90" AutomationProperties.Name="{local:Loc ui.etendue_de_la_sortie}"/>
                <Label Content="{local:Loc ui.periode_ts_s}" Target="{Binding ElementName=Ts}" Margin="12,0,0,0"/>
                <TextBox x:Name="Ts" Width="70" AutomationProperties.Name="{local:Loc ui.periode_d_echantillonnage_en_secondes}"/>
            </WrapPanel>
            <WrapPanel x:Name="CompactPanel" Margin="0,8,0,0" Visibility="Collapsed">
                <Label Content="{local:Loc ui.version}" Target="{Binding ElementName=Version}"/>
                <ComboBox x:Name="Version" Width="90" AutomationProperties.Name="{local:Loc ui.version_de_pidcompact}"/>
                <Label Content="{local:Loc ui.de_sortie_par_unite_de}" Target="{Binding ElementName=PercentPerUnit}" Margin="12,0,0,0"/>
                <TextBox x:Name="PercentPerUnit" Width="70" AutomationProperties.Name="{local:Loc ui.pour_cent_de_sortie_par}"/>
                <Label Content="{local:Loc ui.cpu_facultatif}" Target="{Binding ElementName=Cpu}" Margin="12,0,0,0"/>
                <ComboBox x:Name="Cpu" Width="110" AutomationProperties.Name="{local:Loc ui.famille_de_cpu}">
                    <ComboBoxItem Content="{local:Loc ui.non_precisee}" Tag=""/>
                    <ComboBoxItem Content="S7-1200" Tag="S7-1200"/>
                    <ComboBoxItem Content="S7-1200 G2" Tag="S7-1200 G2"/>
                    <ComboBoxItem Content="S7-1500" Tag="S7-1500"/>
                </ComboBox>
                <Label Content="{local:Loc ui.micrologiciel}" Target="{Binding ElementName=Firmware}" Margin="12,0,0,0"/>
                <TextBox x:Name="Firmware" Width="60" AutomationProperties.Name="{local:Loc ui.micrologiciel_par_exemple_3_1}"/>
            </WrapPanel>
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="Compute" Content="{local:Loc ui.calculer}" Click="Calculate" IsEnabled="False"/>
                <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
            </WrapPanel>
        </StackPanel>
        <TextBox x:Name="Values" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,12,0,0"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="{local:Loc ui.valeurs_du_bloc}"/>
        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button x:Name="CloseButton" Content="{local:Loc ui.fermer}" Click="CloseView"/>
        </WrapPanel>
    </Grid>
</UserControl>
