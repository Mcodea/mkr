<Window x:Class="Mkr.Desktop.PidPrototypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mkr.Desktop"
        Title="{local:Loc ui.orias_laboratoire_pid_hors_ligne}" Width="1100" Height="840"
        MinWidth="790" MinHeight="570" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="22">
        <TextBlock DockPanel.Dock="Bottom" x:Name="Status" Margin="0,10,0,0"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{local:Loc ui.orias_laboratoire_scientifique_pid}"
                           FontSize="11" Foreground="{DynamicResource MkrAccent}" FontWeight="SemiBold"/>
                <TextBlock Text="{local:Loc ui.essai_pid_filtre_hors_ligne}" FontSize="26" FontWeight="SemiBold"
                           Margin="0,7,0,5"/>
                <TextBlock Text="{local:Loc ui.prototype_non_qualifie_industriellement_aucun}"
                           TextWrapping="Wrap" Foreground="{DynamicResource MkrMuted}" Margin="0,0,0,15"/>
                <Border Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel x:Name="InputPanel">
                        <TextBlock Text="{local:Loc ui.01_parametres_manuels_du_regulateur}" FontSize="16"
                                   FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ContextInfo" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MkrMuted}" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Label Content="Kp" Target="{Binding ElementName=Kp}" VerticalAlignment="Center"/>
                            <TextBox x:Name="Kp" Width="90" Margin="0,0,12,0"/>
                            <Label Content="{local:Loc ui.ti_s}" Target="{Binding ElementName=Ti}" VerticalAlignment="Center"/>
                            <TextBox x:Name="Ti" Width="90" Margin="0,0,12,0"/>
                            <Label Content="{local:Loc ui.td_s}" Target="{Binding ElementName=Td}" VerticalAlignment="Center"/>
                            <TextBox x:Name="Td" Width="90" Text="0.2" Margin="0,0,12,0"/>
                            <Label Content="{local:Loc ui.tf_s}" Target="{Binding ElementName=Tf}" VerticalAlignment="Center"/>
                            <TextBox x:Name="Tf" Width="90" Text="0.1"/>
                        </WrapPanel>
                        <TextBlock Text="{local:Loc ui.p_et_i_sur_lecart}"
                                   Foreground="{DynamicResource MkrMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,9"/>
                        <WrapPanel>
                            <Button x:Name="RunButton" Content="{local:Loc ui.comparer_pid_pi}" Click="Run"
                                    Style="{StaticResource MkrPrimaryButton}"
                                    ToolTip="{local:Loc ui.simulation_locale_sur_le_meme}"/>
                            <Button Content="{local:Loc ui.fermer}" Click="CloseDialog" Margin="10,0,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="PlotPanel" Visibility="Collapsed"
                        Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{local:Loc ui.02_courbes_comparees_sur_le}"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="Legend" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MkrMuted}" Margin="0,0,0,8"/>
                        <local:SignalChart x:Name="Chart" Height="680"
                                AutomationProperties.Name="{local:Loc ui.comparaison_temporelle_consigne_mesure_pi}"
                                AutomationProperties.HelpText="{local:Loc ui.molette_zoom_clic_droit_glisse}"/>
                        <TextBlock x:Name="CursorText" Text="{local:Loc ui.survolez_le_graphique_pour_lire}" Foreground="{DynamicResource MkrMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{local:Loc ui.simulation_fopdt_nominale_valeurs_d}"
                                   Foreground="{DynamicResource MkrMuted}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="ResultsPanel" Visibility="Collapsed"
                        Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{local:Loc ui.03_comparaison_des_performances}"
                                   FontWeight="SemiBold" FontSize="16" Margin="0,0,0,9"/>
                        <TextBlock x:Name="ResultMeta" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MkrMuted}" Margin="0,0,0,8"/>
                        <DataGrid x:Name="Metrics" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" Height="150"
                                  AutomationProperties.Name="{local:Loc ui.comparaison_des_performances_pi_et}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{local:Loc ui.methode}" Binding="{Binding Method}" Width="130"/>
                                <DataGridTextColumn Header="IAE" Binding="{Binding Iae, StringFormat=G6}" Width="100"/>
                                <DataGridTextColumn Header="ISE" Binding="{Binding Ise, StringFormat=G6}" Width="100"/>
                                <DataGridTextColumn Header="{local:Loc ui.erreur_finale}" Binding="{Binding FinalError, StringFormat=G6}" Width="130"/>
                                <DataGridTextColumn Header="{local:Loc ui.sat_s}" Binding="{Binding Saturation, StringFormat=G6}" Width="110"/>
                                <DataGridTextColumn Header="{local:Loc ui.rampe_s}" Binding="{Binding RateLimited, StringFormat=G6}" Width="120"/>
                                <DataGridTextColumn Header="{local:Loc ui.gel_i_pas}" Binding="{Binding FrozenSteps}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>