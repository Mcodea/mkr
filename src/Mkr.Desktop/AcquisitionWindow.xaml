<Window x:Class="Mkr.Desktop.AcquisitionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MKR — Acquisition Modbus TCP" Width="750" Height="610" MinWidth="580" MinHeight="460" WindowStartupLocation="CenterOwner">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <TextBlock Text="Acquisition Modbus TCP" FontSize="24" FontWeight="SemiBold"/>
  <TextBlock TextWrapping="Wrap" Margin="0,8,0,12" Text="Lecture de six registres consécutifs. Les trois valeurs REAL32 doivent être disposées dans l’ordre SP, PV, MV. L’horodatage UTC correspond à la réception sur ce poste."/>
  <StackPanel x:Name="Settings">
   <Label Content="_Hôte du banc" Target="{Binding ElementName=Host}"/><TextBox x:Name="Host"/>
   <WrapPanel>
    <StackPanel Margin="0,0,12,0"><Label Content="Port TCP"/><TextBox x:Name="Port" Text="502" Width="72"/></StackPanel>
    <StackPanel Margin="0,0,12,0"><Label Content="Unité Modbus"/><TextBox x:Name="UnitId" Width="92"/></StackPanel>
    <StackPanel><Label Content="Premier registre (offset base 0)"/><TextBox x:Name="Offset"/></StackPanel>
   </WrapPanel>
   <Label Content="Ordre des mots de 16 bits"/><ComboBox x:Name="Order"><ComboBoxItem Content="Mot fort en premier"/><ComboBoxItem Content="Mot faible en premier"/></ComboBox>
   <WrapPanel>
    <StackPanel Margin="0,0,12,0"><Label Content="Unité SP et PV"/><TextBox x:Name="ProcessUnit" Width="100"/></StackPanel>
    <StackPanel Margin="0,0,12,0"><Label Content="Unité MV"/><TextBox x:Name="CommandUnit" Width="100"/></StackPanel>
    <StackPanel Margin="0,0,12,0"><Label Content="Pause entre lectures (ms)"/><TextBox x:Name="Interval" Text="1000"/></StackPanel>
    <StackPanel><Label Content="Nombre maximal"/><TextBox x:Name="Count" Text="120"/></StackPanel>
   </WrapPanel>
  </StackPanel>
  <WrapPanel Margin="0,16,0,12">
   <Button x:Name="Start" Content="_Démarrer la lecture" Click="StartReading"/>
   <Button x:Name="Stop" Content="_Arrêter" Margin="8,0" IsEnabled="False" Click="StopReading"/>
   <Button x:Name="Save" Content="_Enregistrer dans le projet" IsEnabled="False" Click="SaveCapture"/>
  </WrapPanel>
  <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock x:Name="Latest" TextWrapping="Wrap" Margin="0,8"/>
 </StackPanel></ScrollViewer>
</Window>
