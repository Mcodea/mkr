<Window x:Class="Mkr.Desktop.TrialPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MKR — Prévisualisation MV / PV" Width="1020" Height="720"
        MinWidth="720" MinHeight="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="DONNÉES SOURCES / INSPECTION" FontWeight="SemiBold"
                       Foreground="{DynamicResource MkrAccent}" FontSize="11"/>
            <TextBlock Text="Courbes MV et PV brutes" FontWeight="SemiBold" FontSize="23"
                       Margin="0,7,0,5"/>
            <TextBlock x:Name="SourceInfo" TextWrapping="Wrap"
                       Foreground="{DynamicResource MkrMuted}"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource MkrSurface}"
                BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1"
                CornerRadius="6" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Bleu : MV appliquée · orange : PV mesurée · échelles distinctes"
                           Foreground="{DynamicResource MkrMuted}" TextWrapping="Wrap"
                           Margin="0,0,0,12"/>
                <Canvas x:Name="Plot" Grid.Row="1" ClipToBounds="True" MinHeight="300"
                        Background="{DynamicResource MkrSurface}" SizeChanged="PlotResize"
                        MouseLeftButtonDown="StartSelection" MouseLeftButtonUp="EndSelection"
                        MouseLeave="CancelSelection"
                        AutomationProperties.Name="Courbes sources MV et PV en fonction du temps"/>
                <TextBlock Grid.Row="2" Text="Glissez sur le graphique pour délimiter une plage. Une sélection confirmée sera prise en compte uniquement lors du prochain calcul de modèle."
                           Foreground="{DynamicResource MkrMuted}" Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionText" TextWrapping="Wrap"
                       Foreground="{DynamicResource MkrText}" VerticalAlignment="Center"
                       Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Effacer la sélection" Click="ClearSelection" Margin="0,0,8,0"/>
                <Button x:Name="ApplySelection" Content="_Utiliser cette plage pour l'essai"
                        IsEnabled="False" Click="ApplyWindow"
                        Style="{StaticResource MkrPrimaryButton}"
                        ToolTip="Réutiliser ces indices de lignes sources dans une nouvelle identification"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>