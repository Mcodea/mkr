<Window x:Class="Mkr.Desktop.TrialPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mkr.Desktop"
        Title="MKR — Prévisualisation des signaux" Width="1020" Height="720"
        MinWidth="720" MinHeight="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="DONNÉES SOURCES / INSPECTION" FontWeight="SemiBold"
                       Foreground="{DynamicResource MkrAccent}" FontSize="11"/>
            <TextBlock Text="Courbes brutes de la sortie de commande et de la mesure" FontWeight="SemiBold" FontSize="23"
                       Margin="0,7,0,5"/>
            <TextBlock x:Name="SourceInfo" TextWrapping="Wrap"
                       Foreground="{DynamicResource MkrMuted}"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="_Réinitialiser le zoom" Click="ResetZoom" Margin="0,0,8,0" AutomationProperties.Name="Réinitialiser le zoom"/>
                    <Button Content="Exporter l'_image (PNG)…" Click="ExportImage" Margin="0,0,8,0"/>
                    <Button Content="Exporter les _données (CSV)…" Click="ExportData"/>
                </StackPanel>
                <local:SignalChart x:Name="Chart" Grid.Row="1" MinHeight="300" AutomationProperties.Name="Courbes sources de la sortie de commande et de la mesure en fonction du temps"
                                   AutomationProperties.HelpText="Molette : zoom. Clic droit glissé : déplacement. Clic gauche glissé : sélection d'une plage. Double-clic ou touche Origine : vue complète. Flèches : déplacement, plus et moins : zoom."/>
                <TextBlock x:Name="CursorText" Grid.Row="2" Text="Survolez le graphique pour lire les valeurs au curseur." Foreground="{DynamicResource MkrMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionText" TextWrapping="Wrap"
                       Foreground="{DynamicResource MkrText}" VerticalAlignment="Center"
                       Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Effacer la sélection" Click="ClearSelection" Margin="0,0,8,0"/>
                <Button x:Name="ApplySelection" Content="_Utiliser cette plage pour l'essai"
                        IsEnabled="False" Click="ApplyWindow"
                        Style="{StaticResource MkrPrimaryButton}"
                        ToolTip="Réutiliser ces indices de lignes sources dans une nouvelle identification"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>