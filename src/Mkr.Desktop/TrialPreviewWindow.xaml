<Window x:Class="Mkr.Desktop.TrialPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MKR — Prévisualisation MV / PV" Width="1020" Height="720"
        MinWidth="720" MinHeight="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="DONNÉES SOURCES / INSPECTION" FontWeight="SemiBold"
                       Foreground="{StaticResource MkrAccent}" FontSize="11"/>
            <TextBlock Text="Courbes MV et PV brutes" FontWeight="SemiBold" FontSize="23"
                       Margin="0,7,0,5"/>
            <TextBlock x:Name="SourceInfo" TextWrapping="Wrap"
                       Foreground="{StaticResource MkrMuted}"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource MkrSurface}"
                BorderBrush="{StaticResource MkrBorder}" BorderThickness="1"
                CornerRadius="6" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Bleu : MV appliquée · orange : PV mesurée · échelles distinctes"
                           Foreground="{StaticResource MkrMuted}" TextWrapping="Wrap"
                           Margin="0,0,0,12"/>
                <Canvas x:Name="Plot" Grid.Row="1" ClipToBounds="True" MinHeight="300"
                        Background="White" SizeChanged="PlotResize"
                        MouseLeftButtonDown="StartSelection" MouseLeftButtonUp="EndSelection"
                        MouseLeave="CancelSelection"
                        AutomationProperties.Name="Courbes sources MV et PV en fonction du temps"/>
                <TextBlock Grid.Row="2" Text="Glissez sur l'axe du temps pour délimiter une période à examiner. Cela n'entraîne aucun recalcul scientifique."
                           Foreground="{StaticResource MkrMuted}" Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionText" TextWrapping="Wrap"
                       Foreground="{StaticResource MkrText}" VerticalAlignment="Center"
                       Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/>
            <Button Grid.Column="1" Content="Effacer la sélection" Click="ClearSelection"/>
        </Grid>
    </Grid>
</Window>