<Window x:Class="Mkr.Desktop.TrialPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mkr.Desktop"
        Title="{local:Loc ui.orias_previsualisation_des_signaux}" Width="1020" Height="720"
        MinWidth="720" MinHeight="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{local:Loc ui.donnees_sources_inspection}" FontWeight="SemiBold"
                       Foreground="{DynamicResource MkrAccent}" FontSize="11"/>
            <TextBlock Text="{local:Loc ui.courbes_brutes_de_la_sortie}" FontWeight="SemiBold" FontSize="23"
                       Margin="0,7,0,5"/>
            <TextBlock x:Name="SourceInfo" TextWrapping="Wrap"
                       Foreground="{DynamicResource MkrMuted}"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource MkrSurface}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="{local:Loc ui.reinitialiser_le_zoom_2}" Click="ResetZoom" Margin="0,0,8,0" AutomationProperties.Name="{local:Loc ui.reinitialiser_le_zoom}"/>
                    <Button Content="{local:Loc ui.exporter_l_image_png}" Click="ExportImage" Margin="0,0,8,0"/>
                    <Button Content="{local:Loc ui.exporter_les_donnees_csv}" Click="ExportData"/>
                </StackPanel>
                <local:SignalChart x:Name="Chart" Grid.Row="1" MinHeight="300" AutomationProperties.Name="{local:Loc ui.courbes_sources_de_la_sortie}"
                                   AutomationProperties.HelpText="{local:Loc ui.molette_zoom_clic_droit_glisse_3}"/>
                <TextBlock x:Name="CursorText" Grid.Row="2" Text="{local:Loc ui.survolez_le_graphique_pour_lire}" Foreground="{DynamicResource MkrMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionText" TextWrapping="Wrap"
                       Foreground="{DynamicResource MkrText}" VerticalAlignment="Center"
                       Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{local:Loc ui.effacer_la_selection}" Click="ClearSelection" Margin="0,0,8,0"/>
                <Button x:Name="ApplySelection" Content="{local:Loc ui.utiliser_cette_plage_pour_l}"
                        IsEnabled="False" Click="ApplyWindow"
                        Style="{StaticResource MkrPrimaryButton}"
                        ToolTip="{local:Loc ui.reutiliser_ces_indices_de_lignes}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>