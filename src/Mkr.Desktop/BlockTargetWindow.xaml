<Window x:Class="Mkr.Desktop.BlockTargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MKR — Valeurs des blocs PID_INT et PID_Compact (non qualifiées)"
        Width="900" Height="820" MinWidth="620" MinHeight="520" WindowStartupLocation="CenterOwner">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource MkrAccentPale}" BorderBrush="{StaticResource MkrBorder}" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                       Text="Valeurs documentaires, non qualifiées, pour un régulateur PI. Aucune valeur d'installation n'est supposée : renseignez toutes les cases. Relisez et saisissez à la main, jamais par copie automatique."/>
        </Border>
        <StackPanel Grid.Row="1">
            <WrapPanel>
                <Label Content="_Bloc" Target="{Binding ElementName=BlockChoice}"/>
                <ComboBox x:Name="BlockChoice" Width="150" SelectionChanged="BlockChanged" AutomationProperties.Name="Bloc cible">
                    <ComboBoxItem Content="PID_INT" Tag="PID_INT"/>
                    <ComboBoxItem Content="PID_Compact" Tag="PID_Compact"/>
                </ComboBox>
            </WrapPanel>
            <WrapPanel x:Name="IntPanel" Margin="0,8,0,0" Visibility="Collapsed">
                <Label Content="Étendue de la _mesure (unité PV)" Target="{Binding ElementName=PvSpan}"/>
                <TextBox x:Name="PvSpan" Width="90" AutomationProperties.Name="Étendue de la mesure"/>
                <Label Content="Étendue de la _sortie (unité MV)" Target="{Binding ElementName=MvSpan}" Margin="12,0,0,0"/>
                <TextBox x:Name="MvSpan" Width="90" AutomationProperties.Name="Étendue de la sortie"/>
                <Label Content="Période TS (_s)" Target="{Binding ElementName=Ts}" Margin="12,0,0,0"/>
                <TextBox x:Name="Ts" Width="70" AutomationProperties.Name="Période d'échantillonnage en secondes"/>
            </WrapPanel>
            <WrapPanel x:Name="CompactPanel" Margin="0,8,0,0" Visibility="Collapsed">
                <Label Content="_Version" Target="{Binding ElementName=Version}"/>
                <ComboBox x:Name="Version" Width="90" AutomationProperties.Name="Version de PID_Compact"/>
                <Label Content="% de sortie par unité de _MV" Target="{Binding ElementName=PercentPerUnit}" Margin="12,0,0,0"/>
                <TextBox x:Name="PercentPerUnit" Width="70" AutomationProperties.Name="Pour cent de sortie par unité de MV"/>
                <Label Content="_CPU (facultatif)" Target="{Binding ElementName=Cpu}" Margin="12,0,0,0"/>
                <ComboBox x:Name="Cpu" Width="110" AutomationProperties.Name="Famille de CPU">
                    <ComboBoxItem Content="(non précisée)" Tag=""/>
                    <ComboBoxItem Content="S7-1200" Tag="S7-1200"/>
                    <ComboBoxItem Content="S7-1200 G2" Tag="S7-1200 G2"/>
                    <ComboBoxItem Content="S7-1500" Tag="S7-1500"/>
                </ComboBox>
                <Label Content="Micro_logiciel" Target="{Binding ElementName=Firmware}" Margin="12,0,0,0"/>
                <TextBox x:Name="Firmware" Width="60" AutomationProperties.Name="Micrologiciel, par exemple 3.1"/>
            </WrapPanel>
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="Compute" Content="Calcu_ler" Click="Calculate" IsEnabled="False"/>
                <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
            </WrapPanel>
        </StackPanel>
        <TextBox x:Name="Values" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,12,0,0"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="Valeurs du bloc"/>
        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="_Fermer" IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>
