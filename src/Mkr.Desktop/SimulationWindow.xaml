<Window x:Class="Mkr.Desktop.SimulationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MKR — Simulation PI" Width="1140" Height="850" MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Bottom" x:Name="Message" TextWrapping="Wrap" Margin="0,10,0,0"
                   AutomationProperties.LiveSetting="Polite" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="MKR  /  RÉGLAGE  /  SIMULATION" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MkrAccent}" />
                <TextBlock FontSize="27" FontWeight="SemiBold" Text="Comparaison des réglages PI" Margin="0,6,0,0" />
                <TextBlock x:Name="Units" TextWrapping="Wrap" Margin="0,6,0,10" />
                <Border Background="{StaticResource MkrSurface}" BorderBrush="{StaticResource MkrBorder}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,12">
                <StackPanel x:Name="ScenarioForm">
                    <TextBlock Text="01  ·  Paramètres du scénario" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,6">
                        <Label Content="Pas (s)" Target="{Binding ElementName=Sample}" />
                        <TextBox x:Name="Sample" Width="75" />
                        <Label Content="Durée (s)" Target="{Binding ElementName=Duration}" />
                        <TextBox x:Name="Duration" Width="75" />
                        <Label Content="Consigne ΔSP" Target="{Binding ElementName=Setpoint}" />
                        <TextBox x:Name="Setpoint" Width="75" />
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,6">
                        <Label Content="ΔMV min." Target="{Binding ElementName=Lower}" />
                        <TextBox x:Name="Lower" Width="75" />
                        <Label Content="ΔMV max." Target="{Binding ElementName=Upper}" />
                        <TextBox x:Name="Upper" Width="75" />
                        <Label Content="Perturbation ΔMV" Target="{Binding ElementName=Disturbance}" />
                        <TextBox x:Name="Disturbance" Width="75" Text="0" />
                        <Label Content="Instant (s)" Target="{Binding ElementName=DisturbanceAt}" />
                        <TextBox x:Name="DisturbanceAt" Width="75" Text="0" />
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,6">
                        <Label x:Name="RateLabel" Target="{Binding ElementName=Rate}" />
                        <TextBox x:Name="Rate" Width="90" />
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="_Simuler et enregistrer" Click="Run" />
                        <Label Content="_Variation (%)" Target="{Binding ElementName=Variation}" Margin="12,0,0,0"/>
                        <TextBox x:Name="Variation" Width="62" Text="20"
                                 ToolTip="Analyse de sensibilité : de 0 à 50 %, sans recalcul des coefficients PI"/>
                        <Button Content="_Comparer la robustesse" Click="RunRobustness"
                                Style="{StaticResource MkrPrimaryButton}" Margin="8,0,0,0"
                                ToolTip="Sept cas : nominal et variations individuelles de K, τ et θ"/>
                        <Button Content="Analyser 27 _combinaisons" Click="RunCombined"
                                Margin="8,0,0,0"
                                ToolTip="Grille déterministe 3 × 3 × 3 de K, τ, θ ; coefficients PI fixes"/>
                        <Button Content="Essai _PID manuel…" Click="OpenPidPrototype"
                                Margin="8,0,0,0"
                                ToolTip="Laboratoire hors ligne sans sauvegarde ni correspondance constructeur"/>
                        <Label Content="Simulations" Target="{Binding ElementName=Saved}" Margin="10,0,0,0" />
                        <ComboBox x:Name="Saved" Width="215" DisplayMemberPath="Label" SelectionChanged="ShowSaved" />
                        <Button x:Name="SheetButton" Content="Fiche de mise au point (PDF)…" Click="ExportSheet" IsEnabled="False" Margin="8,0,0,0"/>
                        <Button x:Name="ExportButton" Content="_Exporter les séries…" Click="Export" IsEnabled="False" Margin="8,0,0,0" />
                    </WrapPanel>
                </StackPanel>
                </Border>
                <Border Background="{StaticResource MkrSurface}" BorderBrush="{StaticResource MkrBorder}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="02  ·  Indicateurs de comparaison" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="Report" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border x:Name="RobustnessPanel" Visibility="Collapsed"
                        Background="{StaticResource MkrSurface}" BorderBrush="{StaticResource MkrBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="03  ·  Sensibilité des réglages PI"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="RobustnessSummary" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Foreground="{StaticResource MkrMuted}"/>
                        <DataGrid x:Name="RobustnessGrid" HeadersVisibility="Column"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" MaxHeight="340"
                                  AutomationProperties.Name="Résultats de sensibilité IMC et SIMC">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cas" Binding="{Binding Name}" Width="170"/>
                                <DataGridTextColumn Header="K" Binding="{Binding Gain, StringFormat=G5}" Width="65"/>
                                <DataGridTextColumn Header="τ (s)" Binding="{Binding Tau, StringFormat=G5}" Width="70"/>
                                <DataGridTextColumn Header="θ (s)" Binding="{Binding Delay, StringFormat=G5}" Width="70"/>
                                <DataGridTextColumn Header="IAE IMC" Binding="{Binding ImcIae, StringFormat=G5}" Width="95"/>
                                <DataGridTextColumn Header="IAE SIMC" Binding="{Binding SimcIae, StringFormat=G5}" Width="95"/>
                                <DataGridTextColumn Header="Sat. IMC (s)" Binding="{Binding ImcSaturation, StringFormat=G5}" Width="105"/>
                                <DataGridTextColumn Header="Sat. SIMC (s)" Binding="{Binding SimcSaturation, StringFormat=G5}" Width="105"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Étude exploratoire, un paramètre varie à la fois. Les coefficients PI restent fixes. Ne constitue pas une preuve de stabilité ni un intervalle de confiance."
                                   FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MkrMuted}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource MkrSurface}" BorderBrush="{StaticResource MkrBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="04  ·  Analyse temporelle" FontSize="16"
                                   FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="Legend" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Foreground="{StaticResource MkrMuted}"/>
                        <WrapPanel Margin="0,0,0,10">
                            <Button x:Name="ResetZoomButton" Content="_Réinitialiser le zoom"
                                    Click="ResetZoom" IsEnabled="False"
                                    ToolTip="Revenir à toute la durée de la simulation" Margin="0,0,12,0"/>
                            <TextBlock x:Name="ZoomStatus" Text="Horizon complet"
                                       Foreground="{StaticResource MkrMuted}" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <Border BorderBrush="{StaticResource MkrBorder}" BorderThickness="1"
                                Background="{StaticResource MkrCanvas}" CornerRadius="4"
                                Padding="10,8" Margin="0,0,0,10">
                            <TextBlock x:Name="CursorReadout" Text="Cliquez sur le graphique pour inspecter un échantillon enregistré."
                                       Foreground="{StaticResource MkrText}" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </Border>
                        <Canvas x:Name="Plot" Height="570" ClipToBounds="True" SizeChanged="ResizePlot"
                                Background="{StaticResource MkrSurface}"
                                MouseLeftButtonDown="StartPlotSelection"
                                MouseLeftButtonUp="EndPlotSelection"
                                AutomationProperties.Name="Réponses SP et PV, commandes calculées et MV appliquées IMC et SIMC"/>
                        <TextBlock Text="Glissez horizontalement pour zoomer ; cliquez pour inspecter un échantillon. ΔCV est la commande calculée avant limitation ; ΔMV est celle appliquée dans le modèle. Le zoom n'altère ni la simulation ni son export."
                                   Foreground="{StaticResource MkrMuted}" FontSize="11" Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
