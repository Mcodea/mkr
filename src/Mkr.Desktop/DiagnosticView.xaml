<UserControl x:Class="Mkr.Desktop.DiagnosticView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource MkrSurfaceAlt}" BorderBrush="{DynamicResource MkrBorder}" BorderThickness="1" Padding="10,6">
            <DockPanel>
                <Label Content="_Import" Target="{Binding ElementName=Imports}" VerticalAlignment="Center"/>
                <ComboBox x:Name="Imports" Width="360" DisplayMemberPath="Label" SelectionChanged="ImportChanged" MinHeight="28" VerticalAlignment="Center" HorizontalAlignment="Left"
                          AutomationProperties.Name="Import à diagnostiquer"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="350" MinWidth="260" MaxWidth="640"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="PreviewTitle" Text="Lignes source (valeurs brutes inchangées)" FontWeight="SemiBold" Margin="2,0,0,6"/>
                <DataGrid Grid.Row="1" x:Name="Preview" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" RowHeight="26" ColumnHeaderHeight="30"
                          AutomationProperties.Name="Lignes source de l'import"/>
                <TextBlock Grid.Row="1" x:Name="Empty" Text="Aucun import dans ce projet. Importez des données à l'étape Données." Foreground="{DynamicResource MkrMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Redimensionner le panneau"/>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Expander Style="{StaticResource MkrPanel}" Header="Qualité des données (mesurée)">
                        <StackPanel x:Name="Quality"/>
                    </Expander>
                    <Expander Style="{StaticResource MkrPanel}" Header="Constats">
                        <TextBlock x:Name="Findings" TextWrapping="Wrap" Margin="10,8"/>
                    </Expander>
                    <Expander Style="{StaticResource MkrPanel}" Header="Provenance">
                        <TextBlock x:Name="Provenance" TextWrapping="Wrap" Margin="10,8" Foreground="{DynamicResource MkrMuted}"/>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
