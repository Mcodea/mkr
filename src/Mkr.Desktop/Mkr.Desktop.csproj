<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Commercial identity: ORIAS. The assembly name stays Mkr.Desktop (technical name MKR) so that installations, data and updates keep working. -->
    <ApplicationIcon>Assets/orias.ico</ApplicationIcon>
    <Product>ORIAS</Product>
    <AssemblyTitle>ORIAS</AssemblyTitle>
    <Description>Logiciel d’assistance à l’ingénierie de la régulation et de l’asservissement industriel.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/orias-logo.png;Assets/orias-logo-dark.png;Assets/orias-logo-mono.png;Assets/orias-symbol.png;Assets/orias.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Mkr.Core/Mkr.Core.csproj" />
    <ProjectReference Include="../Mkr.Infrastructure/Mkr.Infrastructure.csproj" />
    <None Include="../../engine/catalogue/*.json" Link="engine/catalogue/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../engine/*.py" Exclude="../../engine/test_*.py" Link="engine/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
